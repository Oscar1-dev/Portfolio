---
// src/pages/learning-log.astro
// Built entirely from each project's own `timeline` frontmatter — no separate
// hand-written diary entries, so this can't say something the project pages
// don't already back up.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';

const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL;

type Entry = { date: string; event: string; project: string; slug: string };

const entries: Entry[] = [];
for (const project of projects) {
  for (const t of project.data.timeline ?? []) {
    entries.push({ date: t.date, event: t.event, project: project.data.title, slug: project.slug });
  }
}

// Sort chronologically by the "YYYY-Qn" (or "YYYY-MM") date string.
entries.sort((a, b) => a.date.localeCompare(b.date));

const byPeriod = new Map<string, Entry[]>();
for (const e of entries) {
  const list = byPeriod.get(e.date) ?? [];
  list.push(e);
  byPeriod.set(e.date, list);
}
const periods = [...byPeriod.keys()];
---

<Layout title="Learning Log" description="A chronological log of real project milestones, built from each project's own timeline data.">
  <PageIntro index="05" label="Timeline" title="Learning" accent="log.">
    <p>Every entry below comes directly from a project's own timeline data — {entries.length} milestones across {projects.length} projects, in order. Nothing here is a separate narrative; click through to the project for the full picture.</p>
  </PageIntro>

  <section class="sec wrap timeline" data-scene="archive">
    <ol class="rail">
      {
        periods.map((period, i) => (
          <li class="period" data-reveal style={`--i:${i}`}>
            <span class="period-node" aria-hidden="true" />
            <div class="period-label">{period}</div>
            <ul class="period-entries glass" data-glass>
              {byPeriod.get(period)!.map((e) => (
                <li>
                  <a href={`${base}projects/${e.slug}/`} class="project-tag">
                    {e.project}
                  </a>
                  <span class="event">{e.event}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .timeline {
    padding-bottom: var(--space-16);
  }

  .rail {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
  }

  .rail::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(var(--page-accent), color-mix(in srgb, var(--page-accent) 30%, transparent) 60%, transparent);
  }

  .period {
    position: relative;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .period:first-child {
    border-top: none;
    padding-top: 0;
  }

  .period-node {
    position: absolute;
    left: -28px;
    top: calc(var(--space-6) + 5px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--page-accent);
    box-shadow: 0 0 10px var(--page-accent);
  }

  .period:first-child .period-node {
    top: 5px;
  }

  .period-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--page-accent);
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
    font-weight: 600;
  }

  .period-entries {
    list-style: none;
    margin: 0;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    min-width: 0;
  }

  .period-entries li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3, 0.75rem);
    flex-wrap: wrap;
  }

  .project-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .project-tag:hover {
    border-color: var(--page-accent);
    color: var(--page-accent);
    text-decoration: none;
  }

  .event {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
  }

  @media (max-width: 560px) {
    .period {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
