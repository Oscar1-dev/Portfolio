---
// src/pages/credentials.astro
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import TryHackMeBadge from '../components/TryHackMeBadge.astro';
import SecuritySkills from '../components/SecuritySkills.astro';
import tryhackme from '../data/tryhackme.json';

const { profile, stats, badges, completedRooms, skillsCovered } = tryhackme;
const rarityOrder: Array<'epic' | 'rare' | 'common'> = ['epic', 'rare', 'common'];
---

<Layout title="Credentials" description="TryHackMe badges, completed rooms, and skills — verifying hands-on cybersecurity experience.">
  <PageIntro index="04" label="Security" title="Security" accent="record.">
    <p>Hands-on offensive and defensive security practice, tracked on <a href={profile.profileUrl} target="_blank" rel="noopener noreferrer">TryHackMe</a>.</p>
  </PageIntro>

  <section class="sec wrap stats-sec">
    <dl class="stats-grid" data-reveal>
      <div class="stat"><dt>Badges</dt><dd class="neon">{stats.totalBadges}</dd></div>
      <div class="stat"><dt>Rooms Completed</dt><dd class="neon">{stats.totalRoomsCompleted}</dd></div>
      <div class="stat"><dt>Epic Badges</dt><dd class="neon">{stats.epicBadges}</dd></div>
      <div class="stat"><dt>Rare Badges</dt><dd class="neon">{stats.rareBadges}</dd></div>
    </dl>
  </section>

  <section class="sec wrap">
    <div class="sec-head" data-reveal>
      <div><p class="sec-index">01</p><h2 class="sec-title">Skills covered</h2></div>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <ul class="skills-list">
      {Object.keys(skillsCovered).map((skill) => <li>{skill}</li>)}
    </ul>
  </section>

  <section class="sec wrap">
    <div class="sec-head" data-reveal>
      <div><p class="sec-index">02</p><h2 class="sec-title">Security specialisation</h2></div>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <SecuritySkills />
  </section>

  {
    rarityOrder.map((rarity, i) => (
      <section class="sec wrap">
        <div class="sec-head" data-reveal>
          <div>
            <p class="sec-index">{`0${i + 3}`}</p>
            <h2 class="sec-title cap">{rarity} badges ({badges[rarity].length})</h2>
          </div>
          <span class="sec-rule" aria-hidden="true" />
        </div>
        <div class="badge-grid">
          {badges[rarity].map((badge) => (
            <TryHackMeBadge title={badge.title} description={badge.description} rarity={rarity} rarityPercent={badge.rarityPercent} image={badge.image} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="sec wrap">
    <div class="sec-head" data-reveal>
      <div><p class="sec-index">06</p><h2 class="sec-title">Completed rooms</h2></div>
      <span class="meta">{completedRooms.totalCompleted} total · first {completedRooms.sampleFirst16.length} shown</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <ul class="rooms-list">
      {
        completedRooms.sampleFirst16.map((room) => (
          <li>
            <div class="room-row">
              <span>{room.title}</span>
              <span class="room-difficulty">{room.difficulty}</span>
            </div>
            <div class="room-tags">
              {room.technologyTags.map((t) => <span class="room-tag">{t}</span>)}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sec wrap goals-section" data-reveal>
    <div class="sec-head">
      <div><p class="sec-index">07</p><h2 class="sec-title">Where I'm headed</h2></div>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <p class="goals-intro">
      Stated plainly: these are goals, not claims of current experience. I haven't done live Active Directory
      attack chains, malware analysis, or built custom offensive tooling yet — I'm listing them here because
      they're the specific direction I'm practising toward, not because I've already done them.
    </p>
    <ul class="goals-list">
      <li><strong>Active Directory attack paths</strong> — enumeration, lateral movement, persistence — building on the AD-related TryHackMe rooms above</li>
      <li><strong>Structured malware analysis</strong> (static + dynamic) — a real skill gap right now, not something NEXUS (a deliberately synthetic, non-exploiting training simulator) provides</li>
      <li><strong>Custom security tooling</strong> — none built yet; a natural next step given the scripting already shown in the project work above</li>
      <li><strong>Formal certification</strong> — no certs beyond TryHackMe progress yet; Security+ is the logical next formal step given the foundational rooms already completed</li>
    </ul>
  </section>
</Layout>

<style>
  .stats-sec {
    padding-top: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    padding: 22px 22px 22px 0;
  }

  .stat + .stat {
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }

  .stat dt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .stat dd {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 0.9;
    background: var(--foil);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (max-width: 700px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  .cap {
    text-transform: capitalize;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .skills-list li {
    padding: var(--space-1) var(--space-4);
    background: color-mix(in srgb, var(--page-accent) 10%, transparent);
    border: 1px solid var(--page-accent);
    border-radius: 1rem;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    text-transform: capitalize;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .rooms-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .rooms-list li {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-3, 0.75rem) var(--space-4);
  }

  .room-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .room-difficulty {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  .room-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .room-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.4rem;
  }

  .goals-intro {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-width: 700px;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .goals-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 700px;
  }

  .goals-list strong {
    color: var(--color-text-primary);
  }

  @media (max-width: 600px) {
    .rooms-list {
      grid-template-columns: 1fr;
    }
  }
</style>
