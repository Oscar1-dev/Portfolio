---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Not found" description="This page doesn't exist.">
  <section class="nf wrap">
    <p class="meta">Error 404 · signal lost</p>
    <h1 class="display nf-code"><span class="foil foil-live">404</span></h1>
    <p class="lede">This page doesn't exist, or it moved when the portfolio was rebuilt.</p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={base}>Home</a>
      <a class="btn btn-outline" href={`${base}projects/`}>All projects</a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--header-h);
  }
  .nf-code {
    margin: 12px 0 18px;
    font-size: clamp(7rem, 28vw, 22rem);
    line-height: 0.8;
  }
  .nf-actions {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }
</style>
