---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScrollStatement from '../components/ScrollStatement.astro';
import KushSpotlight from '../components/KushSpotlight.astro';
import FlowCard from '../components/FlowCard.astro';
import MiniCard from '../components/MiniCard.astro';
import Experience from '../components/Experience.astro';
import CyberSummary from '../components/CyberSummary.astro';
import Capabilities from '../components/Capabilities.astro';
import ArchiveRows from '../components/ArchiveRows.astro';
import Mark from '../components/Mark.astro';
import tryhackme from '../data/tryhackme.json';
import { byOrder } from '../data/links';

const all = (await getCollection('projects')).sort(byOrder);
const kush = all.find((p) => p.slug === 'kush')!;
// Lead work after KUSH: the substantial projects with something to show.
const leadSlugs = ['nops-cyber-intelligence', 'mindhouse', 'feedback'];
const lead = leadSlugs.map((s) => all.find((p) => p.slug === s)!).filter(Boolean);
const rest = all.filter((p) => p.slug !== 'kush' && !leadSlugs.includes(p.slug));
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Home"
  description="Oscar Senior (Nops): software engineer and cybersecurity practitioner. Founder and developer of KUSH, Chief Security Officer at Velnqo, builder of NOPS / Cyber Intelligence."
>
  <Hero projectCount={all.length} rooms={tryhackme.stats.totalRoomsCompleted} />

  <ScrollStatement />

  <div id="featured">
    <KushSpotlight project={kush} />
  </div>

  <section id="projects" class="sec wrap" aria-labelledby="lead-title" data-spy-section="projects">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">02</span><span class="seam-line"></span><span class="seam-t mono">Projects</span></div>
    <div class="sec-head">
      <div>
                <h2 id="lead-title" class="sec-title" data-split data-reveal>Projects I can show you working</h2>
      </div>
      <a class="link-arrow" href={`${base}projects/`}>All {all.length} projects <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <FlowCard project={lead[0]} />
    <div class="pair">
      <MiniCard project={lead[1]} kind="mindhouse" />
      <MiniCard project={lead[2]} kind="feedback" />
    </div>
  </section>

  <section id="experience" class="sec wrap" aria-labelledby="experience-title" data-spy-section="experience">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">03</span><span class="seam-line"></span><span class="seam-t mono">Experience</span></div>
    <div class="sec-head">
      <div>
        <h2 id="experience-title" class="sec-title" data-split data-reveal>What I'm doing now</h2>
      </div>
      <span class="meta">Three current roles</span>
    </div>
    <Experience />
  </section>

  <section id="security" class="sec wrap" aria-labelledby="security-title" data-spy-section="security">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">04</span><span class="seam-line"></span><span class="seam-t mono">Cybersecurity</span></div>
    <div class="sec-head">
      <div>
        <h2 id="security-title" class="sec-title" data-split data-reveal>Security, in practice and in code</h2>
      </div>
      <a class="link-arrow" href={`${base}credentials/`}>Security record <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <CyberSummary />
  </section>

  <section class="sec wrap" aria-labelledby="archive-title">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">05</span><span class="seam-line"></span><span class="seam-t mono">Archive</span></div>
    <div class="sec-head">
      <div>
                <h2 id="archive-title" class="sec-title" data-split data-reveal>Everything else I've built</h2>
      </div>
      <a class="link-arrow" href={`${base}projects/`}>Browse every project <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <ArchiveRows projects={rest} />
  </section>

  <section class="sec wrap" aria-labelledby="stack-title">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">06</span><span class="seam-line"></span><span class="seam-t mono">Stack</span></div>
    <div class="sec-head">
      <div>
                <h2 id="stack-title" class="sec-title" data-split data-reveal>Tools I've actually used</h2>
      </div>
      <span class="meta">Every line links to the project it comes from</span>
    </div>
    <Capabilities />
  </section>

  <section id="contact" class="sec wrap contact" aria-labelledby="contact-title" data-spy-section="contact">
    <div class="seam" data-reveal aria-hidden="true"><span class="seam-n mono">07</span><span class="seam-line"></span><span class="seam-t mono">Contact</span></div>
    <div class="contact-card">
      <div>
        <h2 id="contact-title" class="sec-title" data-split data-reveal>Get in touch</h2>
        <p class="lede contact-lede" data-reveal>
          I'm looking for a cybersecurity or IT apprenticeship, or a junior technical role. Email is the quickest way to reach me, and I'm happy
          to talk through anything on this site.
        </p>
      </div>
      <div class="contact-side" data-reveal>
        <a class="contact-mail" href="mailto:nopsrust@gmail.com"><Mark size={36} /><span>nopsrust@gmail.com</span></a>
        <div class="contact-links">
          <a class="btn btn-primary" href="mailto:nopsrust@gmail.com">Email me</a>
          <a class="btn btn-outline" href="https://github.com/Oscar1-dev" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a class="btn btn-outline" href="https://tryhackme.com/p/Oscar.Senior" target="_blank" rel="noopener noreferrer">TryHackMe <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin-top: clamp(16px, 2vw, 28px);
  }
  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding: clamp(22px, 3.4vw, 48px);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(var(--scene-c) / 0.16), transparent 70%),
      linear-gradient(140deg, rgb(var(--fg-rgb) / 0.05), rgb(var(--fg-rgb) / 0.012));
  }
  .contact-lede {
    margin: 16px 0 0;
  }
  .contact-mail {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: var(--tap);
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .contact-mail span {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .contact-links .btn-outline {
    border-color: var(--line-3);
  }
  @media (max-width: 860px) {
    .pair,
    .contact-card {
      grid-template-columns: 1fr;
    }
    .contact-links .btn {
      flex: 1 1 100%;
    }
  }
</style>
