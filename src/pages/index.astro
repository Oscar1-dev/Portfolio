---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SignalHero from '../components/SignalHero.astro';
import KushSpotlight from '../components/KushSpotlight.astro';
import FeatureProject from '../components/FeatureProject.astro';
import Experience from '../components/Experience.astro';
import CyberSummary from '../components/CyberSummary.astro';
import Capabilities from '../components/Capabilities.astro';
import ArchiveRows from '../components/ArchiveRows.astro';
import tryhackme from '../data/tryhackme.json';
import { byOrder } from '../data/links';

const all = (await getCollection('projects')).sort(byOrder);
const kush = all.find((p) => p.slug === 'kush')!;
// Lead work after KUSH: the substantial projects with something to show.
const leadSlugs = ['nops-cyber-intelligence', 'mindhouse', 'feedback'];
const lead = leadSlugs.map((s) => all.find((p) => p.slug === s)!).filter(Boolean);
const rest = all.filter((p) => p.slug !== 'kush' && !leadSlugs.includes(p.slug));
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Home"
  description="Oscar Senior (Nops): software engineer and cybersecurity practitioner. Founder and developer of KUSH, Chief Security Officer at Velnqo, builder of NOPS / Cyber Intelligence."
>
  <SignalHero projectCount={all.length} rooms={tryhackme.stats.totalRoomsCompleted} badges={tryhackme.stats.totalBadges} />

  <div id="featured">
    <KushSpotlight project={kush} />
  </div>

  <section class="sec wrap" aria-labelledby="lead-title">
    <div class="sec-head">
      <div>
        <p class="sec-index">02 · Selected work</p>
        <h2 id="lead-title" class="sec-title">Built, shipped,<br /><span class="foil">documented.</span></h2>
      </div>
      <a class="link-arrow" href={`${base}projects/`}>Every project ({all.length}) <span class="arr" aria-hidden="true">→</span></a>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    {lead.map((project, i) => <FeatureProject project={project} index={String(i + 1).padStart(2, '0')} flip={i % 2 === 1} />)}
  </section>

  <section id="experience" class="sec wrap" aria-labelledby="experience-title">
    <div class="sec-head">
      <div>
        <p class="sec-index">03 · Experience</p>
        <h2 id="experience-title" class="sec-title">Where I<br /><span class="foil">work now.</span></h2>
      </div>
      <span class="meta">Current roles</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <Experience />
  </section>

  <section id="security" class="sec wrap" aria-labelledby="security-title">
    <div class="sec-head">
      <div>
        <p class="sec-index">04 · Cybersecurity</p>
        <h2 id="security-title" class="sec-title">Break it,<br /><span class="foil">then build it right.</span></h2>
      </div>
      <a class="link-arrow" href={`${base}credentials/`}>Security record <span class="arr" aria-hidden="true">→</span></a>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <CyberSummary />
  </section>

  <section class="sec wrap" aria-labelledby="archive-title">
    <div class="sec-head">
      <div>
        <p class="sec-index">05 · Archive</p>
        <h2 id="archive-title" class="sec-title">Everything<br /><span class="foil">else I've made.</span></h2>
      </div>
      <a class="link-arrow" href={`${base}projects/`}>Search the archive <span class="arr" aria-hidden="true">→</span></a>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <ArchiveRows projects={rest} />
  </section>

  <section class="sec wrap" aria-labelledby="stack-title">
    <div class="sec-head">
      <div>
        <p class="sec-index">06 · Stack</p>
        <h2 id="stack-title" class="sec-title">What I<br /><span class="foil">reach for.</span></h2>
      </div>
      <span class="meta">Every line links to the project it comes from</span>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <Capabilities />
  </section>

  <section id="contact" class="sec wrap contact" aria-labelledby="contact-title">
    <p class="sec-index">07 · Contact</p>
    <h2 id="contact-title" class="display contact-title">
      <a href="mailto:nopsrust@gmail.com">nopsrust<wbr /><span class="foil">@gmail.com</span></a>
    </h2>
    <div class="contact-row">
      <p class="lede">Security work, a project, or something KUSH could build: email is quickest. Code and history are on GitHub; security practice is on TryHackMe.</p>
      <div class="contact-links">
        <a class="btn btn-primary" href="mailto:nopsrust@gmail.com">Email me</a>
        <a class="btn btn-outline" href="https://github.com/Oscar1-dev" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="btn btn-outline" href="https://tryhackme.com/p/Oscar.Senior" target="_blank" rel="noopener noreferrer">TryHackMe ↗</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-title {
    margin: 0 0 32px;
    font-size: clamp(2rem, 6.6vw, 6.4rem);
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .contact-title a {
    transition: opacity var(--t);
  }
  .contact-title a:hover {
    opacity: 0.85;
  }
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .contact-row .lede {
    margin: 0;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
