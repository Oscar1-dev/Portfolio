---
// src/pages/projects/[slug].astro — every project's case study (KUSH has
// its own page at projects/kush.astro).
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { assetPath } from '../../data/asset-path';
import { byOrder } from '../../data/links';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(byOrder);
  return projects
    .map((project, i) => ({ project, prev: projects[i - 1], next: projects[i + 1] }))
    .filter(({ project }) => project.slug !== 'kush')
    .map(({ project, prev, next }) => ({ params: { slug: project.slug }, props: { project, prev, next } }));
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const image = data.cover ?? data.logo;
const humanise = (key: string) => key.replace(/_/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
---

<Layout title={data.title} description={data.description} article>
  <article class="case">
    <header class="case-head wrap">
      <a class="case-back meta" href={`${base}projects/`}>← All projects</a>
      <p class="case-meta">
        <span class="status" data-status={data.status}>{data.status}</span>
        <span class="meta">{data.projectType}</span>
        <span class="mono faint">{data.year}</span>
      </p>
      <h1 class="display case-title" data-reveal="clip">{data.title}</h1>
      <div class="case-intro">
        <p class="lede">{data.tagline ?? data.description}</p>
        <div>
          {data.tagline ? <p class="case-desc muted">{data.description}</p> : null}
          {data.statusNote ? <p class="case-note mono">{data.statusNote}</p> : null}
          <ProjectLinks project={project} />
        </div>
      </div>
    </header>

    {
      image ? (
        <figure class="case-cover wrap" data-reveal>
          <img src={assetPath(image)} alt={`${data.title}: screenshot`} width="1600" height="1000" decoding="async" />
        </figure>
      ) : null
    }

    {
      data.flow && data.flow.length > 0 ? (
        <section class="wrap case-block blueprint-panel" data-reveal>
          <p class="sec-index">How it works</p>
          <FlowDiagram steps={data.flow} />
        </section>
      ) : null
    }

    <section class="wrap case-grid">
      <div class="case-block">
        <p class="sec-index">Technology</p>
        <dl class="stack">
          {
            Object.entries(data.technologies).map(([group, items]) => (
              <div class="stack-row">
                <dt class="meta cap">{group}</dt>
                <dd>
                  {items.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="case-block">
        <p class="sec-index">What it demonstrates</p>
        <ul class="competencies">
          {data.competencies.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    {
      data.metrics || data.recognition ? (
        <section class="wrap case-grid">
          {data.metrics ? (
            <div class="case-block">
              <p class="sec-index">Numbers</p>
              <dl class="metrics">
                {Object.entries(data.metrics).map(([k, v]) => (
                  <div>
                    <dt class="meta">{humanise(k)}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : null}
          {data.recognition ? (
            <div class="case-block">
              <p class="sec-index">Recognition</p>
              <ul class="competencies">
                {data.recognition.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          ) : null}
        </section>
      ) : null
    }

    {
      data.timeline && data.timeline.length > 0 ? (
        <section class="wrap case-block">
          <p class="sec-index">Timeline</p>
          <ol class="timeline">
            {data.timeline.map((t) => (
              <li data-reveal>
                <span class="mono">{t.date}</span>
                <span>{t.event}</span>
              </li>
            ))}
          </ol>
        </section>
      ) : null
    }

    <section class="wrap case-block">
      <p class="sec-index">Write-up</p>
      <div class="prose">
        <Content />
      </div>
    </section>

    <nav class="wrap pager" aria-label="More projects">
      {
        prev ? (
          <a href={`${base}projects/${prev.slug}/`} class="pager-link">
            <span class="meta">← Previous</span>
            <span class="display">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`${base}projects/${next.slug}/`} class="pager-link pager-next">
            <span class="meta">Next →</span>
            <span class="display">{next.data.title}</span>
          </a>
        ) : null
      }
    </nav>
  </article>
</Layout>

<style>
  .case-head {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 5rem));
  }
  .case-back {
    display: inline-block;
    margin-bottom: 28px;
    transition: color var(--t-fast);
  }
  .case-back:hover {
    color: var(--text);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin: 0 0 18px;
  }
  .case-title {
    margin: 0 0 30px;
    font-size: clamp(3rem, 10vw, 9rem);
    overflow-wrap: anywhere;
  }
  .case-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px 56px;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .case-intro .lede {
    margin: 0;
    color: var(--text);
  }
  .case-desc {
    margin: 0 0 14px;
  }
  .case-note {
    margin: 0 0 14px;
    font-size: 12.5px;
    color: var(--warn);
  }
  .case-cover {
    margin-block: clamp(2rem, 4vw, 3.5rem);
  }
  .case-cover img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .case-block {
    padding-block: clamp(1.8rem, 3.5vw, 2.8rem);
  }
  .blueprint-panel {
    padding-inline: 0;
  }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 clamp(24px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }
  .stack {
    margin: 0;
  }
  .stack-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .stack-row dd {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
  .competencies {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .competencies li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }
  .competencies li::before {
    content: '+ ';
    font-family: var(--font-mono);
    color: var(--sig-violet);
  }
  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }
  .metrics div {
    padding: 14px 14px 14px 0;
    border-top: 1px solid var(--line);
  }
  .metrics dd {
    margin: 6px 0 0;
    font-size: 1.05rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line-2);
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 14px;
    padding: 10px 0 10px 22px;
    color: var(--text-2);
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 17px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sig-magenta);
  }
  .timeline .mono {
    font-size: 12.5px;
    color: var(--text);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 48%;
  }
  .pager-link .display {
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    overflow-wrap: anywhere;
    transition: opacity var(--t);
  }
  .pager-link:hover .display {
    background: var(--foil);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pager-next {
    text-align: right;
    margin-left: auto;
  }
  @media (max-width: 860px) {
    .case-intro,
    .case-grid {
      grid-template-columns: 1fr;
    }
    .stack-row,
    .timeline li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
