---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ArchiveRows from '../../components/ArchiveRows.astro';
import { areaOf, byOrder } from '../../data/links';

const projects = (await getCollection('projects')).sort(byOrder);

const areas = [...new Set(projects.map((p) => areaOf(p.data.projectType)))];
const statuses = [...new Set(projects.map((p) => p.data.status))];
---

<Layout title="Projects" description={`All ${projects.length} of Oscar Senior's projects: KUSH, NOPS / Cyber Intelligence, MINDHOUSE, FEEDBACK and the full archive, each described from its own source.`}>
  <PageIntro index="01" label="Work" title="Every" accent="project.">
    <p>
      All {projects.length} projects, newest thinking first. Each one is described from its own source code. Where a repository
      isn't public, or was under the old NopsFR GitHub account (no longer online), the project says so.
    </p>
  </PageIntro>

  <section class="wrap archive-page">
    <div class="filters" role="search">
      <label class="search">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input data-archive-search type="search" placeholder="Search by name or technology (e.g. Rust, Stripe, Tauri)" aria-label="Search projects" />
      </label>
      <div class="filter-group" role="group" aria-label="Area">
        <button class="chip" aria-pressed="true" data-area="">All</button>
        {areas.map((a) => <button class="chip" aria-pressed="false" data-area={a}>{a}</button>)}
      </div>
      <div class="filter-group" role="group" aria-label="Status">
        <button class="chip" aria-pressed="true" data-status-filter="">Any status</button>
        {statuses.map((s) => <button class="chip" aria-pressed="false" data-status-filter={s}>{s}</button>)}
      </div>
      <p class="meta" aria-live="polite" data-archive-count>{projects.length} projects</p>
    </div>
    <ArchiveRows projects={projects} filterable />
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-archive]');
    if (!list) return;
    const rows = [...list.querySelectorAll<HTMLElement>('.arow')];
    const search = document.querySelector<HTMLInputElement>('[data-archive-search]')!;
    const count = document.querySelector<HTMLElement>('[data-archive-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-archive-empty]')!;
    let area = '';
    let status = '';
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const ok =
          (!area || row.dataset.area === area) &&
          (!status || row.dataset.status === status) &&
          (!q || q.split(/\s+/).every((w) => (row.dataset.search ?? '').includes(w)));
        row.hidden = !ok;
        if (ok) {
          shown++;
          row.classList.add('is-in');
        }
      }
      count.textContent = `${shown} of ${rows.length} projects`;
      empty.hidden = shown > 0;
    };
    const group = (attr: string, set: (v: string) => void) => {
      const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[${attr}]`)];
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          set(b.getAttribute(attr) ?? '');
          apply();
        }),
      );
    };
    group('data-area', (v) => (area = v));
    group('data-status-filter', (v) => (status = v));
    search.addEventListener('input', apply);
  });
</script>

<style>
  .archive-page {
    padding-bottom: 4rem;
  }
  .filters {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    padding: 16px 0;
    margin-bottom: 8px;
    background: rgb(6 6 8 / 0.92);
    backdrop-filter: blur(10px);
  }
  .search {
    flex: 1 1 320px;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text-3);
  }
  .search:focus-within {
    border-color: var(--sig-magenta);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font: inherit;
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter-group .chip {
    background: none;
    cursor: pointer;
  }
  .filter-group .chip[aria-pressed='true'] {
    background: var(--text);
    color: var(--ink-0);
    border-color: var(--text);
  }
  .filters .meta {
    margin: 0 0 0 auto;
  }
  @media (max-width: 760px) {
    .filters {
      position: static;
      backdrop-filter: none;
    }
  }
</style>
