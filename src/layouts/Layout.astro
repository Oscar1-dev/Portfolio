---
// src/layouts/Layout.astro
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Social preview image (site-relative), defaults to the site card. */
  image?: string;
  /** For case studies: marks the page as an article for social cards. */
  article?: boolean;
}

const { title, description, image = 'og.png', article = false } = Astro.props;
const name = 'Oscar Senior';
const fullTitle = title === 'Home' ? `${name} — Security engineering & software` : `${title} — ${name}`;
const summary =
  description ??
  'Oscar Senior (Nops): software engineer and cybersecurity practitioner. Founder of KUSH, Chief Security Officer at Velnqo.';
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}${image}`.replace(/\/{2,}/g, '/'), Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta name="author" content={name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <meta name="theme-color" content="#060608" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      // Before paint: motion is opt-out by the OS; reveals only hide content
      // once this flag is set, so the page reads fine without JavaScript.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="scene" data-scene-canvas aria-hidden="true" transition:persist="scene"></canvas>
    <div class="atmosphere" aria-hidden="true" transition:persist="atmosphere"></div>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { mountReveal } from '../scripts/reveal';
      import { mountSplitFlaps } from '../scripts/split-flap';
      import { mountHeader } from '../scripts/header';
      import { mountSplit } from '../scripts/split';
      import { mountGlass } from '../scripts/glass';
      import { destroyScroll, mountScroll } from '../scripts/scroll-fx';

      type Scene = { refresh: () => void; dispose: () => void };
      let scene: Scene | null = null;
      let loading = false;

      const capable = () => {
        const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
        if (nav.connection?.saveData) return null;
        try {
          if (!document.createElement('canvas').getContext('webgl2')) return null;
        } catch {
          return null;
        }
        const weak = (nav.hardwareConcurrency ?? 8) <= 4 || (nav.deviceMemory ?? 8) <= 4 || window.innerWidth < 900;
        return { rich: !weak };
      };

      /** The 3D environment loads after the page is idle, once per visit. */
      const startScene = () => {
        if (scene || loading || !document.documentElement.classList.contains('motion-ok')) return scene?.refresh();
        const ability = capable();
        const canvas = document.querySelector<HTMLCanvasElement>('[data-scene-canvas]');
        if (!ability || !canvas) return;
        loading = true;
        const go = () =>
          void import('../scripts/scene').then(({ mountScene }) => {
            scene = mountScene(canvas, ability.rich);
            loading = false;
          });
        if ('requestIdleCallback' in window) window.requestIdleCallback(go, { timeout: 1200 });
        else setTimeout(go, 400);
      };

      // Runs on first load and after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        document.documentElement.classList.toggle('motion-ok', !window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        mountHeader();
        mountSplit();
        mountReveal();
        mountSplitFlaps();
        mountGlass();
        mountScroll();
        startScene();
      });
      document.addEventListener('astro:before-swap', () => destroyScroll());
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
  @import '../styles/animations.css';

  main {
    display: block;
    min-height: 70vh;
    outline: none;
  }
</style>
