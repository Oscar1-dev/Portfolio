---
// src/layouts/Layout.astro
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  /** Social preview image (site-relative), defaults to the site card. */
  image?: string;
  /** For case studies: marks the page as an article for social cards. */
  article?: boolean;
}

const { title, description, image = 'og.png', article = false } = Astro.props;
const name = 'Oscar Senior';
const fullTitle = title === 'Home' ? `${name} (Nops) — Security engineering & software` : `${title} — ${name}`;
const summary =
  description ??
  'Oscar Senior (Nops): software engineer and cybersecurity practitioner. Founder of KUSH, Chief Security Officer at Velnqo.';
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}${image}`.replace(/\/{2,}/g, '/'), Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta name="author" content={name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
    <meta name="theme-color" content="#050606" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oscar Senior, also known as Nops. Security engineering and software." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      // Before first paint, and again after every client-side page swap:
      // theme and motion mode come from a saved choice, else the OS setting.
      // Reveal styles only hide content once `motion-ok` is set, so the page
      // reads fine without JavaScript.
      (() => {
        const apply = () => {
          const d = document.documentElement;
          const get = (k) => {
            try {
              return localStorage.getItem(k);
            } catch {
              return null;
            }
          };
          const theme = get('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          const motion = get('motion') || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full');
          d.dataset.theme = theme;
          d.dataset.motion = motion;
          d.classList.toggle('motion-ok', motion === 'full');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <script>
      import { mountReveal } from '../scripts/reveal';
      import { mountSplitFlaps } from '../scripts/split-flap';
      import { mountHeader } from '../scripts/header';
      import { mountSplit } from '../scripts/split';
      import { mountGlass } from '../scripts/glass';
      import { destroyScroll, mountScroll } from '../scripts/scroll-fx';
      import { mountPrefs } from '../scripts/prefs';
      import { mountMedia } from '../scripts/media';

      const mountMotion = () => {
        mountSplit();
        mountReveal();
        mountSplitFlaps();
        mountGlass();
        mountScroll();
      };
      // Runs on first load and after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        mountPrefs();
        mountHeader();
        mountMotion();
        mountMedia();
      });
      document.addEventListener('astro:before-swap', () => destroyScroll());
      // Switching motion mode re-settles reveals and progress-driven styles.
      document.addEventListener('prefs:motion', mountMotion);
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
  @import '../styles/animations.css';

  main {
    display: block;
    min-height: 70vh;
    outline: none;
  }
</style>
