---
// src/components/ProjectCard.astro
import StatusBadge from './StatusBadge.astro';
import { assetPath } from '../data/asset-path';

export interface Props {
  slug: string;
  title: string;
  description: string;
  status: 'Production' | 'Active' | 'Learning' | 'Archived';
  projectType: string;
  technologies: Record<string, string[]>;
  logo?: string;
  cover?: string;
}

const { slug, title, description, status, projectType, technologies, logo, cover } = Astro.props;
const allTech = Object.values(technologies).flat();
const base = import.meta.env.BASE_URL;
---

<a href={`${base}projects/${slug}`} data-page-link data-reveal data-spotlight class:list={['project-card', { 'has-cover': !!cover }]}>
  {
    cover && (
      <span class="card-cover" aria-hidden="true">
        <img src={assetPath(cover)} alt="" loading="lazy" />
      </span>
    )
  }
  <div class="card-body">
    <div class="card-header">
      {logo && <img src={assetPath(logo)} alt="" class="card-logo" loading="lazy" width="28" height="28" />}
      <div class="card-heading">
        <span class="project-type">{projectType}</span>
        <h3>{title}</h3>
      </div>
      <StatusBadge status={status} />
    </div>
    <p class="description">{description}</p>
    <p class="tech-line">{allTech.join(' · ')}</p>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: inherit;
    overflow: hidden;
    transition:
      border-color var(--transition-safe),
      transform var(--transition-fast),
      box-shadow var(--transition-safe);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.55);
    text-decoration: none;
  }

  .card-cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform: scale(1.02);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .card-cover img {
    transform: scale(1.08);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }

  .has-cover .card-body {
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .card-logo {
    border-radius: 0.25rem;
    object-fit: cover;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-heading {
    flex: 1;
    min-width: 0;
  }

  .project-type {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1);
  }

  h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
  }

  .description {
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .tech-line {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-tag);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
