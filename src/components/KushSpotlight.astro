---
// KUSH, the lead project: a pinned scroll sequence. The copy sits on a glass
// plate; real screenshots of the KUSH website travel through 3D depth as you
// scroll. KUSH's own pastel foil is used here (its brand).
import type { Project } from '../data/links';
import { assetPath } from '../data/asset-path';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const pillars = [
  { k: 'Web platform', v: 'Discord sign-in, accounts, TOTP 2FA, sessions, staff dashboard' },
  { k: 'Platform API', v: 'Fastify, Zod, OpenAPI, Drizzle, PostgreSQL, audit logging' },
  { k: 'Discord', v: 'Provisioned server, permission evaluator, tickets, referrals, bot' },
  { k: 'Commerce', v: 'Commissions, orders, store credit, Stripe (simulated locally)' },
];
const shots = [
  { src: '/images/projects/kush-home.webp', label: 'Home' },
  { src: '/images/projects/kush-services.webp', label: 'Services' },
  { src: '/images/projects/kush-commission.webp', label: 'Start a project' },
  { src: '/images/projects/kush-pricing.webp', label: 'Pricing' },
];
---

<section class="kush" aria-labelledby="kush-title" data-progress="pin" data-scene="kush" style={`--n:${shots.length}`}>
  <div class="kush-frame">
    <div class="wrap kush-grid">
      <div class="kush-plate glass" data-glass>
        <div class="kush-head">
          <p class="sec-index">01 · Featured</p>
          <p class="meta">Founder & developer · 2026 – present</p>
        </div>
        <h2 id="kush-title" class="display kush-word">KUSH</h2>
        <p class="kush-lede">{data.description}</p>
        <p class="kush-status mono"><span aria-hidden="true">◐</span> {data.statusNote}</p>
        <dl class="kush-pillars">
          {
            pillars.map((p) => (
              <div>
                <dt>{p.k}</dt>
                <dd>{p.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="kush-actions">
          <a class="btn btn-kush" href={`${base}projects/kush/`}>
            Read the KUSH case study
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-glass" href="https://github.com/Oscar1-dev/KUSH" target="_blank" rel="noopener noreferrer">Source ↗</a>
        </div>
      </div>

      <div class="kush-stage" aria-label="KUSH website screenshots">
        {
          shots.map((s, i) => (
            <figure class="kshot" style={`--si:${i}`}>
              <img src={assetPath(s.src)} alt={`KUSH website: ${s.label} page`} loading="lazy" decoding="async" width="1600" height="1000" />
              <figcaption class="mono">
                <span>{String(i + 1).padStart(2, '0')}</span> {s.label}
              </figcaption>
            </figure>
          ))
        }
        <div class="kush-progress" aria-hidden="true"><i></i></div>
      </div>
    </div>
    <dl class="kush-metrics wrap">
      {
        Object.entries(data.metrics ?? {}).map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .kush {
    position: relative;
    --p: 0.25;
    overflow-x: clip;
  }
  :global(.motion-ok) .kush {
    height: 340vh;
  }
  .kush-frame {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
    padding: calc(var(--header-h) + 30px) 0 30px;
  }
  :global(.motion-ok) .kush-frame {
    position: sticky;
    top: 0;
    height: 100svh;
  }
  .kush-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .kush-plate {
    padding: clamp(22px, 2.6vw, 36px);
    --glass-bg: rgb(16 15 24 / 0.5);
  }
  .kush-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .kush-head .sec-index,
  .kush-head .meta {
    margin: 0;
  }
  .kush-word {
    margin: 0 0 16px;
    font-size: clamp(4rem, 8.4vw, 8.4rem);
    line-height: 0.8;
    background: var(--kush-holo);
    background-size: 220% 100%;
    background-position: calc(var(--p) * 120%) 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .kush-lede {
    margin: 0 0 12px;
    max-width: 50ch;
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--text-2);
  }
  .kush-status {
    margin: 0 0 18px;
    font-size: 12px;
    color: #f4eec0;
  }
  .kush-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 22px;
    margin: 0 0 22px;
  }
  .kush-pillars div {
    padding: 11px 0;
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }
  .kush-pillars dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cbbcff;
  }
  .kush-pillars dd {
    margin: 5px 0 0;
    font-size: 13.5px;
    color: var(--text-2);
  }
  .kush-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn-kush {
    background: var(--kush-holo);
    background-size: 200% 100%;
    color: #0b0a12;
    transition: background-position 1s var(--ease);
  }
  .btn-kush:hover {
    background-position: 100% 0;
  }

  /* The screenshot carousel lives in 3D: each shot's distance from the
     current scroll position (--d) sets its depth, angle and opacity. */
  .kush-stage {
    position: relative;
    aspect-ratio: 16 / 11;
    perspective: 1600px;
    perspective-origin: 30% 50%;
    transform-style: preserve-3d;
  }
  .kshot {
    --d: calc(var(--p) * (var(--n) - 1) * 1.08 - var(--si));
    --ad: max(var(--d), calc(var(--d) * -1));
    position: absolute;
    inset: 6% 0 auto 0;
    margin: 0;
    transform: translate3d(calc(var(--d) * -46%), calc(var(--ad) * 6%), calc(var(--ad) * -420px)) rotateY(calc(var(--d) * 22deg));
    opacity: clamp(0, calc(1.25 - var(--ad) * 0.75), 1);
    filter: saturate(calc(1 - var(--ad) * 0.4)) brightness(calc(1 - var(--ad) * 0.35));
    z-index: calc(10 - var(--si));
    will-change: transform;
  }
  .kshot img {
    width: 100%;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.95);
  }
  .kshot figcaption {
    margin-top: 12px;
    font-size: 12px;
    color: var(--text-2);
    opacity: clamp(0, calc(1 - var(--ad) * 2), 1);
  }
  .kshot figcaption span {
    color: #cbbcff;
    margin-right: 6px;
  }
  .kush-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgb(255 255 255 / 0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .kush-progress i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--kush-holo);
    transform-origin: left;
    transform: scaleX(var(--p));
  }
  .kush-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: 0;
  }
  .kush-metrics div {
    padding: 14px 16px 0 0;
    border-top: 1px solid var(--line);
  }
  .kush-metrics div + div {
    padding-left: 16px;
  }
  .kush-metrics dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .kush-metrics dd {
    margin: 6px 0 0;
    font-size: 14px;
  }
  /* Without pinning (reduced motion, or small screens) the shots sit in a row. */
  :global(:root:not(.motion-ok)) .kush-stage {
    aspect-ratio: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  :global(:root:not(.motion-ok)) .kshot {
    position: static;
    transform: none;
    opacity: 1;
    filter: none;
  }
  @media (max-width: 1100px) {
    :global(.motion-ok) .kush {
      height: auto;
    }
    :global(.motion-ok) .kush-frame {
      position: relative;
      height: auto;
    }
    .kush-grid {
      grid-template-columns: 1fr;
    }
    .kush-stage {
      aspect-ratio: auto;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      perspective: none;
      padding-bottom: 10px;
    }
    .kshot {
      position: static;
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
      scroll-snap-align: start;
    }
    .kush-progress {
      display: none;
    }
    .kush-metrics {
      grid-template-columns: 1fr 1fr;
    }
    .kush-metrics div:nth-child(3) {
      padding-left: 0;
    }
  }
  @media (max-width: 560px) {
    .kush-pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
