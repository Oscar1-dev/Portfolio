---
// Security, presented as a terminal readout of real records: TryHackMe stats
// from data/tryhackme.json and security work verifiable in project source.
import tryhackme from '../data/tryhackme.json';
const base = import.meta.env.BASE_URL;
const { stats, profile, badges } = tryhackme;
const epic = badges.epic.map((b) => b.title);
const focus = ['Offensive security', 'Reverse engineering', 'Application security', 'Backend systems', 'Security engineering', 'Cybersecurity research'];
const engineered = [
  { what: 'SSRF-hardened outbound fetch layer, DNS-rebinding-safe resolution', where: 'NOPS / Cyber Intelligence', slug: 'nops-cyber-intelligence' },
  { what: 'Discord OAuth2 + PKCE, TOTP 2FA, session revocation, audit logging', where: 'KUSH', slug: 'kush' },
  { what: 'Fail-closed permission checks from live Discord roles', where: 'KUSH', slug: 'kush' },
  { what: 'Sandboxed tool execution with a verified dev/prod security boundary', where: 'MINDHOUSE', slug: 'mindhouse' },
  { what: 'Rate limiting and security headers on a Fastify API', where: 'NEXUS Cyber Lab', slug: 'nexus' },
  { what: 'IP and security audit logging models', where: 'Nops.Bio', slug: 'nops-bio' },
];
---

<div class="cyber" data-progress="pass">
  <div class="term glass" data-glass>
    <div class="term-bar" aria-hidden="true">
      <i></i><i></i><i></i>
      <span class="mono">oscar@signal: ~/security</span>
    </div>
    <div class="term-body mono">
      <p style="--li:0"><span class="prompt">$</span> thm --profile {profile.username}</p>
      <dl class="term-stats" style="--li:1">
        <div><dt>rooms completed</dt><dd>{stats.totalRoomsCompleted}</dd></div>
        <div><dt>badges</dt><dd>{stats.totalBadges}</dd></div>
        <div><dt>epic / rare / common</dt><dd>{stats.epicBadges} / {stats.rareBadges} / {stats.commonBadges}</dd></div>
      </dl>
      <p style="--li:2"><span class="prompt">$</span> thm --badges epic</p>
      <ul class="term-list" style="--li:3">
        {epic.map((b) => <li><span class="term-ok">●</span> {b}</li>)}
      </ul>
      <p style="--li:4"><span class="prompt">$</span> cat focus.txt</p>
      <ul class="term-list term-focus" style="--li:5">
        {focus.map((f) => <li>{f}</li>)}
      </ul>
      <p class="term-cursor" style="--li:6"><span class="prompt">$</span> <span class="caret" aria-hidden="true"></span></p>
    </div>
  </div>

  <div class="cyber-side">
    <p class="meta">Security engineering in shipped code</p>
    <ul class="engineered">
      {
        engineered.map((e, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="eng-what">{e.what}</span>
            <a class="eng-where mono" href={`${base}projects/${e.slug}/`}>{e.where} →</a>
          </li>
        ))
      }
    </ul>
    <div class="cyber-links">
      <a class="btn btn-glass" href={`${base}credentials/`}>Full security record</a>
      <a class="btn btn-glass" href={profile.profileUrl} target="_blank" rel="noopener noreferrer">TryHackMe profile ↗</a>
    </div>
    <p class="faint cyber-honest">TryHackMe progress, not formal certification. Most rooms are foundational; the record page says which.</p>
  </div>
</div>

<style>
  .cyber {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .cyber {
    --p: 1;
  }
  .term {
    --glass-bg: rgb(10 10 16 / 0.55);
    overflow: hidden;
    transform: perspective(1400px) rotateY(calc((0.5 - var(--p)) * 10deg));
  }
  /* Each block of output "prints" as the terminal scrolls up into view. */
  :global(.motion-ok) .term-body > * {
    opacity: clamp(0, calc((var(--p) * 2.4 - var(--li) * 0.16) * 4), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p) * 2.4 - var(--li) * 0.16) * 4), 1)) * 8px);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
    background: rgb(255 255 255 / 0.025);
  }
  .term-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-4);
  }
  .term-bar i:first-child {
    background: var(--sig-red);
  }
  .term-bar .mono {
    margin-left: 10px;
    font-size: 11.5px;
    color: var(--text-3);
  }
  .term-body {
    padding: 18px 20px 22px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .term-body p {
    margin: 14px 0 6px;
    color: var(--text);
  }
  .term-body p:first-child {
    margin-top: 0;
  }
  .prompt {
    color: var(--sig-magenta);
  }
  .term-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 8px 0 4px;
  }
  .term-stats dt {
    font-size: 11px;
    color: var(--text-3);
  }
  .term-stats dd {
    margin: 2px 0 0;
    font-size: 26px;
    color: var(--text);
  }
  .term-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .term-ok {
    color: var(--sig-violet);
  }
  .term-focus li::before {
    content: '> ';
    color: var(--text-3);
  }
  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -2px;
    background: var(--sig-magenta);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .cyber-side .meta {
    margin: 0 0 12px;
  }
  .engineered {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }
  .engineered li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    margin-inline: -16px;
    border-top: 1px solid var(--line);
    border-radius: 12px;
    transition:
      background var(--t) var(--ease),
      translate var(--t) var(--ease);
  }
  .engineered li:hover {
    background: rgb(255 255 255 / 0.035);
    translate: 6px 0;
  }
  .eng-what {
    color: var(--text);
    font-weight: 500;
  }
  .eng-where {
    font-size: 12px;
    color: var(--text-3);
    width: fit-content;
    transition: color var(--t-fast);
  }
  .eng-where:hover {
    color: var(--sig-magenta);
  }
  .cyber-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cyber-honest {
    margin: 16px 0 0;
    font-size: 13px;
  }
  @media (max-width: 960px) {
    .cyber {
      grid-template-columns: 1fr;
    }
  }
</style>
