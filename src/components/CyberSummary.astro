---
// Security, as a record rather than a costume: TryHackMe figures straight
// from data/tryhackme.json, and the security work that exists in project code,
// each line taken from that project's own write-up. Nothing here is simulated
// output. The six controls are ordered like the plates in the "Layers" film.
import tryhackme from '../data/tryhackme.json';
const base = import.meta.env.BASE_URL;
const { stats, profile, badges } = tryhackme;
const focus = ['Offensive security', 'Reverse engineering', 'Application security', 'Backend systems', 'Security engineering', 'Cybersecurity research'];
const rarity = [
  { label: 'Epic', n: stats.epicBadges },
  { label: 'Rare', n: stats.rareBadges },
  { label: 'Common', n: stats.commonBadges },
];
const layers = [
  {
    layer: 'Network edge',
    what: 'SSRF-hardened outbound requests',
    where: 'NOPS / Cyber Intelligence',
    slug: 'nops-cyber-intelligence',
    detail:
      'User-supplied URLs are checked before any network call: allow-listed schemes and ports, a blocked-hostname list (localhost, .internal, cloud metadata endpoints), DNS resolution that refuses any address that is not public, and the same checks again on every redirect hop.',
  },
  {
    layer: 'Identity',
    what: 'Discord OAuth2 with PKCE, TOTP two-factor and revocable sessions',
    where: 'KUSH',
    slug: 'kush',
    detail:
      'The website server never sees a client secret and the PKCE verifier stays in the API. Each sign-in state can be redeemed once, only by the browser that started it. Accounts can add TOTP with single-use recovery codes and replay protection; sessions expire, idle out and can be revoked per device.',
  },
  {
    layer: 'Authorisation',
    what: 'Staff permissions that fail closed',
    where: 'KUSH',
    slug: 'kush',
    detail:
      "Permissions are decided on the server from a member's current Discord roles, matched by role ID rather than name. If Discord can't be reached, the API refuses access instead of guessing.",
  },
  {
    layer: 'Execution',
    what: 'Sandboxed tool execution with a dev/production boundary',
    where: 'MINDHOUSE',
    slug: 'mindhouse',
    detail:
      "Filesystem and terminal tools are confined to one workspace directory: paths are resolved and prefix-checked, so traversal attempts are rejected. The tool server is a Vite plugin with apply: 'serve', which means that code is not in a production build at all.",
  },
  {
    layer: 'API surface',
    what: 'Rate limiting and security headers on a Fastify API',
    where: 'NEXUS Cyber Lab',
    slug: 'nexus',
    detail:
      'Built with @fastify/helmet, @fastify/rate-limit and @fastify/cors, JWT auth through jose and Zod-validated input. The lab itself is deliberately synthetic: it never scans or exploits a real system.',
  },
  {
    layer: 'Audit trail',
    what: 'IP and security audit logging',
    where: 'Nops.Bio',
    slug: 'nops-bio',
    detail: 'IpLog and SecurityLog tables in the Prisma schema record IP addresses and sensitive account actions.',
  },
];
---

<div class="cyber">
  <section class="record glass" data-glass aria-labelledby="record-title" data-reveal>
    <header class="record-head">
      <h3 id="record-title" class="meta">Practice record · TryHackMe</h3>
      <p class="record-user mono">{profile.username}</p>
    </header>
    <dl class="record-stats">
      <div>
        <dt>Rooms completed</dt>
        <dd class="display" data-count={stats.totalRoomsCompleted}>{stats.totalRoomsCompleted}</dd>
      </div>
      <div>
        <dt>Badges earned</dt>
        <dd class="display" data-count={stats.totalBadges}>{stats.totalBadges}</dd>
      </div>
    </dl>
    <div class="rarity">
      <p class="meta" id="rarity-label">Badges by rarity</p>
      <ul aria-labelledby="rarity-label">
        {
          rarity.map((r, i) => (
            <li style={`--share:${r.n / stats.totalBadges};--ri:${i}`}>
              <span class="rarity-bar" aria-hidden="true" />
              <span class="rarity-text"><b>{r.n}</b> {r.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="epic">
      <p class="meta">Epic badges</p>
      <ul>
        {badges.epic.map((b) => <li><b>{b.title}</b><span>{b.description}</span></li>)}
      </ul>
    </div>
    <div class="focus">
      <p class="meta">Where my attention goes</p>
      <ul>{focus.map((f) => <li class="tag">{f}</li>)}</ul>
    </div>
    <p class="record-honest">
      This is practice, not a certification. Most of these rooms are foundational, and the <a href={`${base}credentials/`}>security record</a> says which.
    </p>
  </section>

  <section class="layers" aria-labelledby="layers-title">
    <h3 id="layers-title" class="meta">Security engineering in shipped code</h3>
    <p class="layers-lede">Six controls I've built into real projects. Open one for what it actually does.</p>
    <ol class="layer-list">
      {
        layers.map((l, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <details name="layers" open={i === 0}>
              <summary>
                <span class="layer-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="layer-head">
                  <span class="layer-tag mono">{l.layer}</span>
                  <span class="layer-what">{l.what}</span>
                </span>
                <span class="layer-chev" aria-hidden="true" />
              </summary>
              <div class="layer-body">
                <p>{l.detail}</p>
                <a class="link-arrow" href={`${base}projects/${l.slug}/`}>
                  Read it in the {l.where} write-up <span class="arr" aria-hidden="true">→</span>
                </a>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
    <div class="cyber-links">
      <a class="btn btn-glass" href={`${base}credentials/`}>Full security record</a>
      <a class="btn btn-glass" href={profile.profileUrl} target="_blank" rel="noopener noreferrer">TryHackMe profile <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
    </div>
  </section>
</div>

<script>
  // Count the two headline figures up once, when they first appear.
  document.addEventListener('astro:page-load', () => {
    const els = [...document.querySelectorAll<HTMLElement>('[data-count]')];
    if (!els.length || !document.documentElement.classList.contains('motion-ok')) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 4))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    });
    els.forEach((el) => io.observe(el));
  });
</script>

<style>
  .cyber {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .record {
    display: grid;
    gap: 26px;
    padding: clamp(22px, 3vw, 36px);
  }
  .record-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
  }
  .record-head h3 {
    margin: 0;
    font-weight: 400;
  }
  .record-user {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .record-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0;
  }
  .record-stats dt {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .record-stats dd {
    margin: 4px 0 0;
    font-size: clamp(3rem, 7vw, 5.4rem);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
  }
  .rarity ul,
  .epic ul,
  .focus ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .rarity li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem;
    align-items: center;
    gap: 14px;
    padding: 5px 0;
  }
  /* Each bar has its own hatch so the three are told apart without colour. */
  .rarity-bar {
    height: 12px;
    border: 1px solid var(--line-3);
    border-radius: 2px;
    background: linear-gradient(90deg, var(--text) calc(var(--share) * 100%), transparent 0);
  }
  .rarity li:nth-child(2) .rarity-bar {
    background:
      repeating-linear-gradient(135deg, var(--text) 0 3px, transparent 3px 6px) 0 0 / calc(var(--share) * 100%) 100% no-repeat;
  }
  .rarity li:nth-child(3) .rarity-bar {
    background:
      repeating-linear-gradient(90deg, var(--text) 0 1px, transparent 1px 5px) 0 0 / calc(var(--share) * 100%) 100% no-repeat;
  }
  :global(.motion-ok) .record:not(.is-in) .rarity-bar {
    clip-path: inset(0 100% 0 0);
  }
  :global(.motion-ok) .rarity-bar {
    transition: clip-path 1200ms var(--ease) calc(300ms + var(--ri) * 140ms);
    clip-path: inset(0);
  }
  .rarity-text {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .rarity-text b {
    display: inline-block;
    min-width: 1.6em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .epic li {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .epic li span {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .focus ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .record-honest {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
    font-size: var(--text-sm);
    color: var(--text-2);
  }

  .layers h3 {
    margin: 0 0 10px;
    font-weight: 400;
  }
  .layers-lede {
    margin: 0 0 22px;
    max-width: 52ch;
    color: var(--text-2);
  }
  .layer-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-2);
  }
  .layer-list > li {
    border-bottom: 1px solid var(--line-2);
  }
  summary {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 24px;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 12px 6px 12px 0;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .layer-n {
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .layer-head {
    display: grid;
    gap: 2px;
  }
  .layer-tag {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .layer-what {
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.35;
  }
  summary:hover .layer-what {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Plus becomes minus when the row is open. */
  .layer-chev {
    position: relative;
    width: 24px;
    height: 24px;
  }
  .layer-chev::before,
  .layer-chev::after {
    content: '';
    position: absolute;
    left: 5px;
    right: 5px;
    top: 11px;
    height: 2px;
    background: var(--text);
    transition: rotate var(--t) var(--ease);
  }
  .layer-chev::after {
    rotate: 90deg;
  }
  details[open] .layer-chev::after {
    rotate: 0deg;
  }
  .layer-body {
    padding: 0 0 22px calc(2.4rem + 12px);
  }
  .layer-body p {
    margin: 0 0 14px;
    max-width: 62ch;
    color: var(--text-2);
    line-height: 1.65;
  }
  :global(.motion-ok) details[open] .layer-body {
    animation: layer-open 600ms var(--ease);
  }
  @keyframes layer-open {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  .cyber-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  @media (max-width: 900px) {
    .cyber {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .layer-body {
      padding-left: 0;
    }
    .rarity li {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
    }
  }
</style>
