---
// src/components/FlowDiagram.astro
// A connected step diagram for a project's request/data flow. Steps reveal
// progressively as the section scrolls into view (see data-reveal-group).
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<ol class="flow" data-reveal-group="flow">
  {
    steps.map((step, i) => (
      <li class="flow-step" data-reveal data-reveal-group="flow">
        <span class="flow-index">{String(i + 1).padStart(2, '0')}</span>
        <span class="flow-label">{step}</span>
        {i < steps.length - 1 && (
          <span class="flow-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow-step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .flow-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-secondary);
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
  }

  .flow-label {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.85rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    max-width: 260px;
    transition:
      border-color var(--transition-safe),
      transform var(--transition-fast);
  }

  .flow-step:hover .flow-label {
    border-color: var(--color-accent-secondary);
    transform: translateY(-1px);
  }

  .flow-arrow {
    display: inline-flex;
    color: var(--color-text-tertiary);
    margin: 0 var(--space-1);
    flex-shrink: 0;
  }

  .flow-arrow svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 700px) {
    .flow {
      flex-direction: column;
      align-items: flex-start;
    }

    .flow-step {
      width: 100%;
    }

    .flow-arrow svg {
      transform: rotate(90deg);
    }
  }
</style>
