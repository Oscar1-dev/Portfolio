---
// A featured project as a layered composition: a large image that tilts in
// 3D and drifts as it scrolls through the viewport, with a glass plate
// carrying the text overlapping its edge.
import ProjectLinks from './ProjectLinks.astro';
import { assetPath } from '../data/asset-path';
import type { Project } from '../data/links';
interface Props {
  project: Project;
  index: string;
  flip?: boolean;
}
const { project, index, flip = false } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const image = data.cover ?? data.logo;
const stack = Object.values(data.technologies).flat().slice(0, 6);
---

<article class:list={['feature', { flip }]} data-progress="pass">
  <a class="feature-media" href={`${base}projects/${project.slug}/`} aria-label={`${data.title} case study`} tabindex="-1">
    <span class="feature-tilt">
      {
        image ? (
          <img src={assetPath(image)} alt="" loading="lazy" decoding="async" width="1600" height="1000" />
        ) : (
          <span class="feature-type display" aria-hidden="true">
            {data.title}
          </span>
        )
      }
      <span class="feature-scan" aria-hidden="true"></span>
    </span>
    <span class="feature-index display" aria-hidden="true">{index}</span>
  </a>
  <div class="feature-plate glass" data-glass>
    <p class="feature-meta">
      <span class="status" data-status={data.status}>{data.status}</span>
      <span class="meta">{data.projectType} · {data.year}</span>
    </p>
    <h3 class="display feature-title"><a href={`${base}projects/${project.slug}/`}>{data.title}</a></h3>
    <p class="feature-lede">{data.tagline ?? data.description}</p>
    {data.statusNote ? <p class="feature-note mono">{data.statusNote}</p> : null}
    <ul class="feature-stack" aria-label="Main technologies">
      {stack.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <div class="feature-actions">
      <a class="link-arrow" href={`${base}projects/${project.slug}/`}>Read the case study <span class="arr" aria-hidden="true">→</span></a>
      <ProjectLinks project={project} compact />
    </div>
  </div>
</article>

<style>
  .feature {
    --p: 0.5;
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .feature-media {
    grid-column: 1 / span 8;
    grid-row: 1;
    position: relative;
    display: block;
    perspective: 1400px;
  }
  .feature.flip .feature-media {
    grid-column: 5 / span 8;
  }
  /* Scroll-driven tilt: leans back as it enters, settles flat at centre,
     leans forward as it leaves, with a parallax drift against the plate. */
  .feature-tilt {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: var(--ink-2);
    box-shadow: var(--shadow-deep);
    transform: rotateX(calc((0.5 - var(--p)) * 18deg)) translateY(calc((0.5 - var(--p)) * 60px));
    transform-origin: 50% 50%;
  }
  .feature-tilt img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: top;
    transform: translateY(calc((var(--p) - 0.5) * -8%));
    transition: filter 1.2s var(--ease);
    filter: saturate(0.92);
  }
  .feature:hover .feature-tilt img {
    filter: saturate(1.08) brightness(1.04);
  }
  .feature-type {
    position: absolute;
    inset: auto 28px 22px;
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.3);
    overflow-wrap: anywhere;
  }
  .feature-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -2px;
    height: 2px;
    background: var(--foil);
    opacity: 0;
  }
  .feature:hover .feature-scan {
    animation: scan 1.6s var(--ease) forwards;
  }
  @keyframes scan {
    0% {
      top: -2px;
      opacity: 0.9;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
  /* A huge outline index sits behind the image edge and drifts on scroll. */
  .feature-index {
    display: none;
    position: absolute;
    top: -0.42em;
    left: -0.06em;
    z-index: -1;
    font-size: clamp(6rem, 14vw, 13rem);
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.12);
    translate: 0 calc((0.5 - var(--p)) * 120px);
  }
  .feature.flip .feature-index {
    left: auto;
    right: -0.06em;
  }
  .feature-plate {
    grid-column: 8 / span 5;
    grid-row: 1;
    z-index: 2;
    padding: clamp(22px, 2.6vw, 34px);
    translate: 0 calc((0.5 - var(--p)) * -70px);
  }
  .feature.flip .feature-plate {
    grid-column: 1 / span 5;
  }
  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0 0 14px;
  }
  .feature-title {
    font-size: clamp(1.9rem, 3vw, 3rem);
    margin: 0 0 14px;
    overflow-wrap: break-word;
  }
  .feature-title a:hover {
    background: var(--foil);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .feature-lede {
    margin: 0 0 12px;
    color: var(--text-2);
    font-size: 1rem;
    line-height: 1.6;
  }
  .feature-note {
    margin: 0 0 14px;
    font-size: 12px;
    color: var(--warn);
  }
  .feature-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }
  .feature-stack .tag {
    background: rgb(255 255 255 / 0.04);
  }
  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  @media (max-width: 960px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature-media,
    .feature.flip .feature-media,
    .feature-plate,
    .feature.flip .feature-plate {
      grid-column: 1;
      grid-row: auto;
    }
    .feature-plate {
      margin: -48px 14px 0;
      translate: none;
    }
    .feature-index {
      display: none;
    }
  }
</style>
