---
// A featured project as an editorial spread: big image, big type, no card box.
import ProjectLinks from './ProjectLinks.astro';
import { assetPath } from '../data/asset-path';
import type { Project } from '../data/links';
interface Props {
  project: Project;
  index: string;
  flip?: boolean;
}
const { project, index, flip = false } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const image = data.cover ?? data.logo;
const stack = Object.values(data.technologies).flat().slice(0, 6);
---

<article class:list={['feature', { flip }]} data-reveal>
  <a class="feature-media" href={`${base}projects/${project.slug}/`} aria-label={`${data.title} case study`} tabindex="-1">
    {
      image ? (
        <img src={assetPath(image)} alt="" loading="lazy" decoding="async" width="1600" height="1000" />
      ) : (
        <span class="feature-type display" aria-hidden="true">{data.title}</span>
      )
    }
    <span class="feature-scan" aria-hidden="true"></span>
  </a>
  <div class="feature-text">
    <p class="feature-meta">
      <span class="mono feature-index">{index}</span>
      <span class="status" data-status={data.status}>{data.status}</span>
      <span class="meta">{data.projectType} · {data.year}</span>
    </p>
    <h3 class="display feature-title"><a href={`${base}projects/${project.slug}/`}>{data.title}</a></h3>
    <p class="feature-lede">{data.tagline ?? data.description}</p>
    {data.statusNote ? <p class="feature-note mono">{data.statusNote}</p> : null}
    <ul class="feature-stack" aria-label="Main technologies">
      {stack.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <div class="feature-actions">
      <a class="link-arrow" href={`${base}projects/${project.slug}/`}>Read the case study <span class="arr" aria-hidden="true">→</span></a>
      <ProjectLinks project={project} compact />
    </div>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .feature.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  }
  .feature.flip .feature-media {
    order: 2;
  }
  .feature-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--ink-2);
  }
  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition:
      transform 1.2s var(--ease),
      filter 1.2s var(--ease);
    filter: saturate(0.9);
  }
  .feature:hover .feature-media img {
    transform: scale(1.035);
    filter: saturate(1.05);
  }
  .feature-type {
    position: absolute;
    inset: auto 24px 18px;
    font-size: clamp(2.4rem, 6vw, 5rem);
    color: transparent;
    -webkit-text-stroke: 1px var(--line-3);
    overflow-wrap: anywhere;
  }
  /* A single scanline that crosses the image on hover. */
  .feature-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -2px;
    height: 2px;
    background: var(--foil);
    opacity: 0;
  }
  .feature:hover .feature-scan {
    animation: scan 1.6s var(--ease) forwards;
  }
  @keyframes scan {
    0% {
      top: -2px;
      opacity: 0.9;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin: 0 0 18px;
  }
  .feature-index {
    color: var(--sig-magenta);
    font-size: 12px;
  }
  .feature-title {
    font-size: clamp(2rem, 3.3vw, 3.3rem);
    margin: 0 0 16px;
    overflow-wrap: break-word;
  }
  .feature-title a:hover {
    background: var(--foil);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .feature-lede {
    margin: 0 0 14px;
    max-width: 52ch;
    color: var(--text-2);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .feature-note {
    margin: 0 0 16px;
    font-size: 12px;
    color: var(--warn);
  }
  .feature-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }
  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }
  @media (max-width: 860px) {
    .feature,
    .feature.flip {
      grid-template-columns: 1fr;
    }
    .feature.flip .feature-media {
      order: 0;
    }
  }
</style>
