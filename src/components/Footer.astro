---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>&copy; {year} Oscar. Built with Astro.</p>
    <ul class="footer-links">
      <li><a href="https://github.com/Oscar1-dev" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href="https://tryhackme.com/p/Oscar.Senior" target="_blank" rel="noopener noreferrer">TryHackMe</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }
</style>
