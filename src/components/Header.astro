---
// src/components/Header.astro — persistent left sidebar on desktop; on narrow
// screens a sticky top bar (brand row + a nav row that scrolls within itself,
// so it can never push the page wider than the viewport).
import tryhackme from '../data/tryhackme.json';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === base) return path === base || path === base.replace(/\/$/, '');
  return path.startsWith(href);
};

const navItems = [
  { href: base, index: '01', label: 'Home', icon: 'M3 11.5 12 4l9 7.5M5 10v9.5a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10' },
  { href: `${base}projects`, index: '02', label: 'Projects', icon: 'M4 5.5A1.5 1.5 0 0 1 5.5 4h4l1.5 2h9A1.5 1.5 0 0 1 21.5 7.5v11A1.5 1.5 0 0 1 20 20H5.5A1.5 1.5 0 0 1 4 18.5v-13Z' },
  { href: `${base}credentials`, index: '03', label: 'Credentials', icon: 'M12 3.5 4.5 6.5v5c0 5 3.2 8.6 7.5 10 4.3-1.4 7.5-5 7.5-10v-5L12 3.5Z M9.5 12l1.8 1.8L15 10' },
  { href: `${base}learning-log`, index: '04', label: 'Learning Log', icon: 'M6 4h9l4 4v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z M14.5 4v4.5H19 M9 13h6 M9 16.5h6' },
  { href: `${base}about`, index: '05', label: 'About', icon: 'M12 12.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c.8-3.6 3.6-6 7-6s6.2 2.4 7 6' },
];
---

<aside class="sidebar">
  <div class="sidebar-top">
    <a href={base} class="brand" data-page-link aria-label="Oscar Senior — home">
      <span class="brand-mark" aria-hidden="true">OS</span>
      <span class="brand-text">Oscar Senior<small>Security · Development</small></span>
    </a>
  </div>

  <nav class="nav" aria-label="Main navigation">
    <span class="nav-label">Navigate</span>
    <ul class="nav-list" data-nav-list>
      <li class="nav-indicator" data-nav-indicator aria-hidden="true"></li>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} data-page-link class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <span class="nav-text">{item.label}</span>
              <span class="nav-index" aria-hidden="true">{item.index}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar-footer">
    <button type="button" id="theme-toggle" class="theme-toggle">
      <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
      </svg>
      <span id="theme-toggle-label">Dark mode</span>
    </button>
    <span class="footer-stat">{tryhackme.stats.totalBadges} badges · {tryhackme.stats.totalRoomsCompleted} rooms</span>
    <a href="https://github.com/Oscar1-dev" target="_blank" rel="noopener noreferrer" class="footer-link link-arrow">GitHub <span class="arr">↗</span></a>
  </div>
</aside>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-toggle-label');
    if (!btn || !label) return;
    function sync() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      label.textContent = isLight ? 'Light mode' : 'Dark mode';
      btn.setAttribute('aria-pressed', String(isLight));
    }
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      }
      sync();
    });
    sync();
  })();

  (function () {
    var list = document.querySelector('[data-nav-list]');
    var indicator = document.querySelector('[data-nav-indicator]');
    if (!list || !indicator) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var horizontal = function () {
      return window.matchMedia('(max-width: 860px)').matches;
    };
    function place(el, animate) {
      if (!el) {
        indicator.style.opacity = '0';
        return;
      }
      var lr = list.getBoundingClientRect();
      var r = el.getBoundingClientRect();
      indicator.style.transition = animate && !reduced ? 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), width 0.3s cubic-bezier(0.16, 1, 0.3, 1), height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease' : 'none';
      indicator.style.opacity = '1';
      if (horizontal()) {
        indicator.style.width = r.width + 'px';
        indicator.style.height = '';
        indicator.style.transform = 'translateX(' + (r.left - lr.left + list.scrollLeft) + 'px)';
      } else {
        indicator.style.width = '';
        indicator.style.height = r.height + 'px';
        indicator.style.transform = 'translateY(' + (r.top - lr.top) + 'px)';
      }
    }
    var active = list.querySelector('.nav-link.active');
    place(active, false);
    if (active && horizontal()) active.scrollIntoView({ block: 'nearest', inline: 'center' });
    list.querySelectorAll('.nav-link').forEach(function (link) {
      link.addEventListener('mouseenter', function () {
        place(link, true);
      });
      link.addEventListener('focus', function () {
        place(link, true);
      });
    });
    list.addEventListener('mouseleave', function () {
      place(list.querySelector('.nav-link.active'), true);
    });
    window.addEventListener('resize', function () {
      place(list.querySelector('.nav-link.active'), false);
    });
  })();
</script>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100vh;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  :root[data-theme='light'] .sidebar {
    background: var(--color-surface);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .sidebar-top {
    padding: var(--space-6) var(--space-6) var(--space-8);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    background: linear-gradient(145deg, color-mix(in srgb, var(--page-accent) 22%, transparent), transparent 70%);
    transition:
      border-color var(--transition-safe),
      box-shadow var(--transition-safe);
  }

  .brand:hover .brand-mark {
    border-color: var(--page-accent);
    box-shadow: 0 0 18px -4px var(--page-accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.15;
  }

  .brand-text small {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-top: 3px;
  }

  .nav {
    flex: 1;
    padding: 0 var(--space-4);
    overflow-y: auto;
  }

  .nav-label {
    display: block;
    padding: 0 var(--space-2);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .nav-list {
    position: relative;
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0 0 0 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--page-accent);
    box-shadow: 0 0 12px var(--page-accent);
    opacity: 0;
    pointer-events: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.6rem var(--space-3);
    border-radius: 0.45rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-link .icon {
    color: var(--color-text-tertiary);
    transition:
      color var(--transition-fast),
      transform 0.3s var(--ease-out-expo);
  }

  .nav-index {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-safe),
      transform var(--transition-safe);
  }

  .nav-link:hover {
    background: color-mix(in srgb, var(--color-bg-raised) 80%, transparent);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link:hover .icon {
    color: var(--color-text-secondary);
    transform: translateX(2px);
  }

  .nav-link:hover .nav-index,
  .nav-link.active .nav-index {
    opacity: 1;
    transform: none;
  }

  .nav-link.active {
    background: color-mix(in srgb, var(--color-bg-raised) 90%, transparent);
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .nav-link.active .icon,
  .nav-link.active .nav-index {
    color: var(--page-accent);
  }

  .sidebar-footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.4rem;
    padding: 0.4rem 0.6rem;
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-family: var(--font-body);
    cursor: pointer;
    width: 100%;
    transition: border-color var(--transition-safe);
  }

  .theme-toggle:hover {
    border-color: var(--color-text-tertiary);
  }

  .icon-sun {
    display: none;
  }

  :root[data-theme='light'] .icon-sun {
    display: block;
  }

  :root[data-theme='light'] .icon-moon {
    display: none;
  }

  .footer-stat {
    color: var(--color-text-tertiary);
  }

  .footer-link {
    font-size: var(--text-xs);
  }

  @media (max-width: 860px) {
    .sidebar {
      position: sticky;
      top: 0;
      width: 100%;
      height: auto;
      flex-direction: column;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .sidebar-top {
      padding: var(--space-3) var(--gutter) var(--space-2);
    }

    .brand-mark {
      width: 30px;
      height: 30px;
    }

    .nav {
      padding: 0;
      overflow: visible;
    }

    .nav-label,
    .nav-index,
    .sidebar-footer {
      display: none;
    }

    .nav-list {
      flex-direction: row;
      gap: var(--space-1);
      margin: 0;
      padding: 0 var(--gutter) var(--space-2);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .nav-list::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      white-space: nowrap;
      padding: 0.5rem 0.7rem;
    }

    .nav-indicator {
      top: auto;
      bottom: calc(var(--space-2) - 1px);
      left: 0;
      width: 0;
      height: 2px;
    }
  }
</style>
