---
// src/components/TryHackMeBadge.astro
export interface Props {
  title: string;
  description: string;
  rarity: 'epic' | 'rare' | 'common';
  rarityPercent: number;
  image: string;
}

const { title, description, rarity, rarityPercent, image } = Astro.props;
---

<div class={`badge badge-${rarity}`}>
  <img src={image} alt="" loading="lazy" width="48" height="56" />
  <div class="badge-body">
    <p class="badge-title">{title}</p>
    <p class="badge-description">{description}</p>
    <p class="badge-rarity">{rarity} · {rarityPercent}% of players</p>
  </div>
</div>

<style>
  .badge {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .badge img {
    border-radius: 0.25rem;
    flex-shrink: 0;
  }

  .badge-title {
    margin: 0;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .badge-description {
    margin: var(--space-1) 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .badge-rarity {
    margin: 0;
    font-size: var(--text-xs);
    text-transform: capitalize;
    font-family: var(--font-mono);
  }

  .badge-epic {
    border-color: var(--text);
  }
  .badge-epic .badge-rarity {
    color: var(--text);
    font-weight: 600;
  }

  .badge-rare {
    border-color: var(--accent);
  }
  .badge-rare .badge-rarity {
    color: var(--accent);
  }

  .badge-common {
    border-color: var(--color-border);
  }
  .badge-common .badge-rarity {
    color: var(--color-text-secondary);
  }
</style>
