---
import { siSpotify } from 'simple-icons';
const playlists = ['37UM9wxbOSNKMcbNmCQbeI', '2L81QkDl0dH8NEihcrtz9Z', '1Ikwne5uReBFXHnvIIF8YN'];
---
<section class="music" aria-labelledby="music-title" data-spotify>
  <header class="music-head">
    <p class="meta">Soundtrack · Spotify</p>
    <h3 id="music-title">On repeat</h3>
    <p>My playlists, recent listening and the music I keep coming back to.</p>
    <a href="https://open.spotify.com/user/3135pu6uanknbgqv6i6zdgzssci4" target="_blank" rel="noopener noreferrer" class="music-profile"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={siSpotify.path} /></svg> My Spotify profile <span class="sr-only">(opens in a new tab)</span> ↗</a>
  </header>
  <div class="listening-panel" aria-busy="true" data-listening>
    <p class="meta">Listening now</p>
    <p role="status" data-listening-status>Checking Spotify…</p>
    <div data-current class="current-track"></div>
    <noscript>Live listening needs JavaScript. You can still open my playlists below.</noscript>
  </div>
  <div class="playlist-grid">
    {playlists.map((id, i) => (
      <article class="playlist-card">
        <h4>Playlist {String(i + 1).padStart(2, '0')}</h4>
        <div class="embed-shell" data-embed-shell>
          <p class="embed-loading" data-embed-status>Spotify player loads when in view.</p>
          <iframe title={`Spotify playlist ${i + 1} from Oscar's new account`} src={`https://open.spotify.com/embed/playlist/${id}?theme=0`} width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
        </div>
        <a href={`https://open.spotify.com/playlist/${id}`} target="_blank" rel="noopener noreferrer">Open playlist {i + 1} on Spotify ↗<span class="sr-only"> (opens in a new tab)</span></a>
      </article>
    ))}
  </div>
  <div class="history-grid">
    <section aria-labelledby="recent-heading"><h4 id="recent-heading">Recently played</h4><p class="music-note">A recent snapshot, not a lifetime listening history.</p><p data-recent-empty>Waiting for listening data.</p><ol data-recent class="music-items"></ol></section>
    <section aria-labelledby="top-heading"><h4 id="top-heading">Recent favourites</h4><p class="music-note">Top tracks and artists over roughly the last four weeks, when available.</p><p data-top-empty>Waiting for listening data.</p><h5>Tracks</h5><ol data-top-tracks class="music-items"></ol><h5>Artists</h5><ul data-top-artists class="music-items"></ul></section>
  </div>
  <p class="music-note">Music and artwork supplied by Spotify. Playback is provided by the official players above or opens in Spotify. Live listening may be delayed.</p>
</section>
<script>
  import { mountSpotify } from '../scripts/spotify';
  document.addEventListener('astro:page-load', mountSpotify);
</script>
<style>
  .music { margin-top: clamp(3rem, 7vw, 5.5rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .music-head { margin-bottom: 1.75rem; }
  h3 { font-size: var(--text-2xl); margin: 0 0 12px; }
  h4 { font-size: var(--text-lg); margin: 0 0 12px; }
  h5 { font-size: var(--text-base); margin: 20px 0 12px; }
  p { color: var(--text-2); }
  .music-profile { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; }
  .music-profile svg { fill: currentColor; flex-shrink: 0; }
  .listening-panel, .playlist-card, .history-grid > section { min-width: 0; padding: clamp(16px, 2vw, 24px); background: var(--ink-1); border: 1px solid var(--line-2); border-radius: 12px; }
  .listening-panel { margin-bottom: 24px; }
  .listening-panel[aria-busy='true'] { min-height: 160px; background: linear-gradient(120deg, var(--ink-1), var(--ink-3), var(--ink-1)); }
  .playlist-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .playlist-card a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 10px; font-size: var(--text-sm); }
  .embed-shell { position: relative; min-height: 352px; background: #121212; border-radius: 12px; }
  iframe { position: relative; display: block; border: 0; border-radius: 12px; max-width: 100%; }
  .embed-loading { position: absolute; inset: 20px; margin: 0; color: #eee; font-size: .875rem; }
  .history-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .music-note { font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .music-items { padding: 0; margin: 0; list-style: none; }
  .music :global(.music-row) { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); min-width: 0; }
  .music :global(.music-row:last-child) { border-bottom: 0; }
  .music :global(.music-art) { width: 64px; height: 64px; flex: 0 0 64px; object-fit: contain; border-radius: 4px; }
  .music :global(.music-detail) { min-width: 0; overflow-wrap: anywhere; }
  .music :global(.music-detail a) { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; line-height: 1.4; }
  .music :global(.music-detail p), .music :global(.music-detail time) { margin: 4px 0; color: var(--text-2); font-size: var(--text-sm); }
  .music :global(progress) { display: block; width: 100%; max-width: 400px; height: 6px; margin-top: 14px; accent-color: var(--text); }
  @media(max-width: 1050px) { .playlist-grid { grid-template-columns: 1fr; } }
  @media(max-width: 640px) { .history-grid { grid-template-columns: 1fr; } }
</style>
