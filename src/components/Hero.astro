---
// Home hero. The rendered "Teardown" loop fills the frame and plays on its own;
// the copy sits on a scrim so it holds contrast over every frame of the video.
// The whole block uses the dark token set in both themes, because the film is dark.
import SceneMedia from './SceneMedia.astro';
interface Props {
  projectCount: number;
  rooms: number;
}
const { projectCount, rooms } = Astro.props;
const base = import.meta.env.BASE_URL;
const interests = ['Reverse engineering', 'Application security', 'Rust & Tauri desktop apps', 'Backend systems'];
---

<section class="hero theme-dark" aria-labelledby="hero-name">
  <SceneMedia name="hero-teardown" title="Teardown, the opening film" fill priority focus="64% 50%" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="hero-kicker mono" data-hero-in style="--d:0">
      <span>Oscar Senior</span><span class="sep" aria-hidden="true"></span><span>also known as Nops</span>
    </p>

    <h1 id="hero-name" class="hero-title display">
      <span class="hero-line" data-hero-line style="--d:1"><span>I take systems</span></span>
      <span class="hero-line" data-hero-line style="--d:2"><span>apart to see</span></span>
      <span class="hero-line" data-hero-line style="--d:3"><span class="foil">how they work.</span></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-lede" data-hero-in style="--d:5">
        Then I build my own. I'm a final-year cybersecurity and IT student at DISC, the founder of
        <a href={`${base}projects/kush/`}>KUSH</a> and Chief Security Officer at Velnqo.
      </p>
      <div class="hero-actions" data-hero-in style="--d:6">
        <a class="btn btn-primary" href={`${base}projects/`}>
          See {projectCount} projects
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn btn-glass" href={`${base}projects/kush/`}>KUSH case study</a>
      </div>
    </div>

    <ul class="hero-interests" aria-label="What I work on" data-hero-in style="--d:7">
      {interests.map((t) => <li>{t}</li>)}
      <li><a href={`${base}credentials/`}>{rooms} TryHackMe rooms</a></li>
    </ul>
  </div>

  <p class="hero-plate mono" aria-hidden="true">Fig. 01 — Teardown · original render, Blender Cycles · 10 s loop</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 680px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #050606;
    color: var(--text);
    isolation: isolate;
  }
  /* Scrim: guarantees text contrast over the film, strongest where text sits. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(5 6 6 / 0.88) 0%, rgb(5 6 6 / 0.62) 38%, rgb(5 6 6 / 0.05) 72%),
      linear-gradient(0deg, rgb(5 6 6 / 0.92) 0%, rgb(5 6 6 / 0.35) 34%, transparent 58%),
      linear-gradient(180deg, rgb(5 6 6 / 0.7) 0%, transparent 22%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: clamp(64px, 9vh, 96px);
  }
  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .hero-kicker .sep {
    width: 34px;
    height: 1px;
    background: var(--sig-red);
  }
  .hero-title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.6rem, 8.4vw, 8.2rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .hero-line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.14em;
    padding-bottom: 0.06em;
  }
  .hero-line > span {
    display: inline-block;
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(24px, 4.5vh, 48px);
    max-width: 1080px;
  }
  .hero-lede {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: #e6e3ea;
  }
  .hero-lede a {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-interests {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin: clamp(26px, 4.5vh, 44px) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: #d5d2db;
  }
  .hero-interests li {
    padding: 4px 18px 4px 0;
    margin-right: 18px;
    border-right: 1px solid rgb(255 255 255 / 0.28);
  }
  .hero-interests li:last-child {
    border-right: 0;
    margin-right: 0;
  }
  .hero-interests a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-plate {
    position: absolute;
    right: calc(var(--gutter) + 62px);
    bottom: 32px;
    z-index: 2;
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9c6d0;
  }
  .hero :global(.sm-toggle) {
    right: var(--gutter);
    bottom: 18px;
  }

  /* Entrance: lines rise out of their masks, then the rest settles in. */
  :global(.motion-ok) .hero-line > span {
    animation: hero-rise 1300ms var(--ease) both;
    animation-delay: calc(200ms + var(--d) * 110ms);
  }
  :global(.motion-ok) [data-hero-in] {
    animation: hero-in 1100ms var(--ease) both;
    animation-delay: calc(260ms + var(--d) * 110ms);
  }
  @keyframes hero-rise {
    from {
      translate: 0 110%;
      rotate: 3deg;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  @media (max-width: 860px) {
    .hero-scrim {
      background:
        linear-gradient(0deg, rgb(5 6 6 / 0.96) 0%, rgb(5 6 6 / 0.8) 46%, rgb(5 6 6 / 0.2) 78%),
        linear-gradient(180deg, rgb(5 6 6 / 0.7) 0%, transparent 24%);
    }
    .hero-plate {
      display: none;
    }
    .hero-inner {
      padding-bottom: 84px;
    }
    .hero-actions,
    .hero-actions .btn {
      width: 100%;
    }
    .hero-interests li {
      border-right: 0;
      margin-right: 0;
      flex: 1 1 100%;
      padding-block: 2px;
    }
  }
  @media (forced-colors: active) {
    .hero-scrim {
      background: Canvas;
      opacity: 0.85;
    }
  }
</style>
