---
// Home hero. The "Orbit" film (media-src/blender/hero_film.py) fills the frame:
// four real project screens as lit panels, one lap of the camera, 12 s loop.
// Copy sits on a scrim at the left; the film keeps its subject right of centre.
// The four projects in the film are also plain links under the copy, so nothing
// in the film is the only way to reach them. Dark token set in both themes.
import SceneMedia from './SceneMedia.astro';
interface Props {
  projectCount: number;
  rooms: number;
}
const { projectCount, rooms } = Astro.props;
const base = import.meta.env.BASE_URL;
const inFilm = [
  { slug: 'nops-cyber-intelligence', name: 'NOPS / Cyber Intelligence' },
  { slug: 'kush', name: 'KUSH' },
  { slug: 'mindhouse', name: 'MINDHOUSE' },
  { slug: 'feedback', name: 'FEEDBACK' },
];
---

<section class="hero theme-dark" aria-labelledby="hero-name">
  <SceneMedia name="hero-film" title="Orbit, the opening film" fill priority focus="66% 50%" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="hero-kicker mono" data-hero-in style="--d:0"><span>Oscar Senior</span><span class="sep" aria-hidden="true"></span><span>Security &amp; software</span></p>
    <h1 id="hero-name" class="hero-title">
      <span class="hero-line" style="--d:1"><span>I pull software apart</span></span>
      <span class="hero-line" style="--d:2"><span>to learn how it works,</span></span>
      <span class="hero-line" style="--d:3"><span class="foil">then build my own.</span></span>
    </h1>
    <p class="hero-lede" data-hero-in style="--d:5">
      Final-year cybersecurity and IT student at DISC. I'm building <a href={`${base}projects/kush/`}>KUSH</a>, I'm Chief Security Officer at
      Velnqo, and I've finished {rooms} rooms on TryHackMe.
    </p>
    <div class="hero-actions" data-hero-in style="--d:6">
      <a class="btn btn-primary" href={`${base}projects/`}>
        Browse {projectCount} projects
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn btn-glass" href={`${base}credentials/`}>Security work</a>
    </div>
    <nav class="hero-film-links" aria-label="Projects shown in the film" data-hero-in style="--d:7">
      <span class="mono" aria-hidden="true">On screen</span>
      <ul>
        {inFilm.map((p) => <li><a href={`${base}projects/${p.slug}/`}>{p.name}</a></li>)}
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 660px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: #050606;
    color: var(--text);
    isolation: isolate;
  }
  /* Guarantees contrast for the copy over every frame of the film. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(5 6 6 / 0.93) 0%, rgb(5 6 6 / 0.78) 30%, rgb(5 6 6 / 0.12) 58%, transparent 75%),
      linear-gradient(0deg, rgb(5 6 6 / 0.9) 0%, transparent 26%),
      linear-gradient(180deg, rgb(5 6 6 / 0.75) 0%, transparent 20%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 72px;
  }
  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0 0 20px;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #cdcad3;
  }
  .hero-kicker .sep {
    width: 28px;
    height: 1px;
    background: var(--sig-red);
  }
  .hero-title {
    margin: 0;
    max-width: 15ch;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108;
    font-weight: 750;
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .hero-line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.14em;
    padding-bottom: 0.06em;
  }
  .hero-line > span {
    display: inline-block;
  }
  .hero-lede {
    max-width: 42ch;
    margin: 22px 0 0;
    font-size: clamp(1rem, 1.2vw, 1.13rem);
    line-height: 1.6;
    color: #e6e3ea;
  }
  .hero-lede a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-film-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin-top: 30px;
    font-size: 0.9rem;
  }
  .hero-film-links .mono {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b9b6c0;
  }
  .hero-film-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-film-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 8px;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 5px;
    transition: background var(--t-fast), text-decoration-color var(--t-fast);
  }
  .hero-film-links a:hover {
    background: rgb(255 255 255 / 0.1);
    text-decoration-color: #fff;
  }
  .hero :global(.sm-toggle) {
    right: var(--gutter);
    bottom: 20px;
  }

  :global(.motion-ok) .hero-line > span {
    animation: hero-rise 1100ms var(--ease) both;
    animation-delay: calc(120ms + var(--d) * 90ms);
  }
  :global(.motion-ok) [data-hero-in] {
    animation: hero-in 1000ms var(--ease) both;
    animation-delay: calc(160ms + var(--d) * 90ms);
  }
  @keyframes hero-rise {
    from {
      translate: 0 110%;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }

  /* Phones: the film gets the top of the screen to itself, the copy sits below it. */
  @media (max-width: 860px) {
    .hero {
      justify-content: flex-end;
      min-height: 0;
    }
    .hero :global(.scene-fill) {
      bottom: auto;
      height: 46svh;
    }
    .hero-scrim {
      background:
        linear-gradient(180deg, rgb(5 6 6 / 0.7) 0, transparent 14svh),
        linear-gradient(180deg, transparent 30svh, #050606 46svh);
    }
    .hero-inner {
      padding-top: 40svh;
      padding-bottom: 40px;
    }
    .hero :global(.sm-toggle) {
      top: calc(46svh - 64px);
      bottom: auto;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (forced-colors: active) {
    .hero-scrim {
      background: Canvas;
      opacity: 0.85;
    }
  }
</style>
