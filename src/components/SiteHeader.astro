---
// Top navigation. Same links drive the desktop bar and the mobile menu.
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}projects/`, label: 'Work', n: '01' },
  { href: `${base}projects/kush/`, label: 'KUSH', n: '02' },
  { href: `${base}#experience`, label: 'Experience', n: '03' },
  { href: `${base}credentials/`, label: 'Security', n: '04' },
  { href: `${base}learning-log/`, label: 'Log', n: '05' },
  { href: `${base}about/`, label: 'About', n: '06' },
];
---

<header class="site-header" data-site-header transition:persist>
  <div class="site-header-inner glass" data-glass>
    <a class="brand" href={base} aria-label="Oscar Senior, home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M5 26 16 5l11 21M10 17.5h12"></path></svg>
      </span>
      <span class="brand-name">
        <b>Oscar Senior</b>
        <span>Nops</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a data-nav href={l.href}><span class="nav-n">{l.n}</span>{l.label}</a>)}
    </nav>
    <span class="header-progress" aria-hidden="true"></span>
    <div class="header-end">
      <a class="header-gh" href="https://github.com/Oscar1-dev" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.4c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
      </a>
      <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only">Menu</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
  <div class="menu glass-strong" id="site-menu" data-menu data-open="false">
    <nav aria-label="Main (mobile)">
      {links.map((l, i) => <a data-nav href={l.href} style={`--i:${i}`}><span class="nav-n">{l.n}</span><span class="display">{l.label}</span></a>)}
    </nav>
    <p class="meta">nopsrust@gmail.com · github.com/Oscar1-dev</p>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 14px 0 auto;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding-inline: 14px;
    pointer-events: none;
  }
  .site-header-inner {
    pointer-events: auto;
    width: min(100%, 1240px);
    height: 58px;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 0 10px 0 14px;
    border-radius: 999px;
    --glass-bg: rgb(16 15 22 / 0.32);
    transition:
      height var(--t) var(--ease),
      width var(--t-slow) var(--ease),
      background var(--t) var(--ease);
  }
  .site-header:global(.is-condensed) .site-header-inner {
    height: 52px;
    width: min(100%, 1120px);
    --glass-bg: rgb(14 13 20 / 0.62);
  }
  /* Reading progress: a hairline along the pill's bottom edge in the
     scene's current colours. */
  .header-progress {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 0;
    height: 1.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgb(var(--scene-a)), rgb(var(--scene-b)), rgb(var(--scene-c)));
    transform-origin: left;
    transform: scaleX(var(--page-p, 0));
    opacity: 0.9;
    pointer-events: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--foil);
    background-size: 220% 100%;
    transition: background-position 1.2s var(--ease);
  }
  .brand:hover .brand-mark {
    background-position: 100% 0;
  }
  .brand-mark svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 2.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name b {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .brand-name span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .nav {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .nav a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    transition:
      color var(--t-fast),
      background var(--t) var(--ease);
  }
  .nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  /* The current page: a lit pill with a foil hairline. */
  .nav a[aria-current='page'] {
    color: var(--text);
    background: rgb(255 255 255 / 0.09);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--foil);
  }
  .nav-n {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-3);
  }
  .header-end {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .header-gh {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text-2);
    transition:
      color var(--t-fast),
      background var(--t-fast);
  }
  .header-gh:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.08);
  }
  .header-gh svg {
    width: 19px;
    height: 19px;
  }
  .menu-toggle {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.05);
  }
  .menu-toggle i {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.6px;
    background: var(--text);
    transition:
      transform var(--t) var(--ease),
      top var(--t) var(--ease);
  }
  .menu-toggle i:first-of-type {
    top: 15px;
  }
  .menu-toggle i:last-of-type {
    top: 23px;
  }
  .menu-toggle[aria-expanded='true'] i:first-of-type {
    top: 19px;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] i:last-of-type {
    top: 19px;
    transform: rotate(-45deg);
  }
  .menu {
    display: none;
  }
  @media (max-width: 960px) {
    .nav {
      display: none;
    }
    .header-end {
      margin-left: auto;
    }
    .menu-toggle {
      display: block;
    }
    .menu {
      pointer-events: auto;
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 100px var(--gutter) 34px;
      background: rgb(8 8 12 / 0.72);
      -webkit-backdrop-filter: blur(28px) saturate(1.4);
      backdrop-filter: blur(28px) saturate(1.4);
      clip-path: circle(0% at calc(100% - 40px) 40px);
      visibility: hidden;
      transition:
        clip-path 800ms var(--ease),
        visibility 0s linear 800ms;
    }
    .menu[data-open='true'] {
      clip-path: circle(150% at calc(100% - 40px) 40px);
      visibility: visible;
      transition:
        clip-path 900ms var(--ease),
        visibility 0s;
    }
    .menu nav {
      display: flex;
      flex-direction: column;
    }
    .menu a {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
      opacity: 0;
      translate: 0 24px;
      transition:
        opacity 600ms var(--ease),
        translate 800ms var(--ease);
    }
    .menu[data-open='true'] a {
      opacity: 1;
      translate: none;
      transition-delay: calc(120ms + var(--i) * 55ms);
    }
    .menu a .display {
      font-size: clamp(2.2rem, 11vw, 3.6rem);
    }
    .menu a[aria-current='page'] .display {
      background: var(--foil);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }
</style>
