---
// Top navigation. The same link list drives the desktop bar, the mobile menu
// and the command palette (data/nav.ts).
import Mark from './Mark.astro';
import { navLinks } from '../data/nav';
const base = import.meta.env.BASE_URL;
const links = navLinks(base);
---

<header class="site-header" data-site-header transition:persist>
  <div class="site-header-inner glass" data-glass>
    <a class="brand" href={base}>
      <span class="brand-mark"><Mark size={34} animate /></span>
      <span class="brand-name">
        <b>Oscar Senior</b>
        <span>a.k.a. Nops</span>
      </span>
      <span class="sr-only">, home</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a data-nav data-spy={l.spy} href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-end">
      <button class="hbtn hbtn-find" type="button" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <span class="hbtn-text">Find</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
        <span class="sr-only">anything on this site (opens the command palette)</span>
      </button>
      <button class="hbtn" type="button" data-theme-toggle aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="i-moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
          <g class="i-sun"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.700l1.800-1.800"></path></g>
        </svg>
        <span class="sr-only">Light theme</span>
      </button>
      <button class="hbtn" type="button" data-motion-toggle aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g class="i-motion"><path d="M3 12h4M3 7h7M3 17h7"></path><circle cx="16" cy="12" r="5"></circle></g>
          <g class="i-still"><circle cx="12" cy="12" r="8"></circle><path d="M10 9v6M14 9v6"></path></g>
        </svg>
        <span class="sr-only">Reduce motion</span>
      </button>
      <button class="hbtn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only">Menu</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
  <div class="menu" id="site-menu" data-menu data-open="false">
    <nav aria-label="Main (menu)">
      <ul>
        <li><a data-nav href={base} style="--i:0"><span class="nav-n" aria-hidden="true">00</span><span class="display">Home</span></a></li>
        {
          links.map((l, i) => (
            <li>
              <a data-nav data-spy={l.spy} href={l.href} style={`--i:${i + 1}`}>
                <span class="nav-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="display">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-prefs">
      <button class="btn btn-outline" type="button" data-theme-toggle aria-pressed="false"><span data-label>Dark theme</span><span class="sr-only">. Switch theme</span></button>
      <button class="btn btn-outline" type="button" data-motion-toggle aria-pressed="false"><span data-label>Full motion</span><span class="sr-only">. Switch motion mode</span></button>
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-prefs-live></p>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding-inline: 12px;
    pointer-events: none;
  }
  .site-header-inner {
    pointer-events: auto;
    width: min(100%, 1280px);
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    padding: 7px 8px 7px 14px;
    border-radius: 18px;
    transition: background var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    padding-right: 6px;
    border-radius: 12px;
  }
  .brand-mark {
    color: var(--text);
    transition: rotate 900ms var(--ease);
  }
  /* The mark has half-turn symmetry: a 180° spin lands on itself. */
  :global(.motion-ok) .brand:hover .brand-mark,
  :global(.motion-ok) .brand:focus-visible .brand-mark {
    rotate: 180deg;
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-name b {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118;
    font-weight: 800;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .brand-name span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }
  .nav {
    margin-left: auto;
  }
  .nav ul,
  .menu ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 14px;
    border-radius: 12px;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color var(--t-fast), background var(--t) var(--ease);
  }
  .nav a:hover {
    color: var(--text);
    background: rgb(var(--fg-rgb) / 0.07);
  }
  /* Current page or section: weight, colour and a bar, never colour alone. */
  .nav a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 8px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--t) var(--ease);
  }
  .nav a[aria-current] {
    color: var(--text-strong);
    font-weight: 650;
  }
  .nav a[aria-current]::after {
    scale: 1 1;
  }
  .header-end {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hbtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: var(--tap);
    height: var(--tap);
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: var(--text-2);
    font-size: 0.9rem;
    transition: color var(--t-fast), background var(--t-fast), border-color var(--t-fast);
  }
  .hbtn:hover {
    color: var(--text);
    background: rgb(var(--fg-rgb) / 0.08);
  }
  .hbtn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hbtn-find {
    border-color: var(--line-3);
    padding-inline: 12px 8px;
  }
  .hbtn kbd {
    padding: 3px 7px;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-2);
  }
  /* Toggle icons show the mode you are in. */
  .i-sun,
  .i-still {
    display: none;
  }
  [data-theme-toggle][aria-pressed='true'] .i-sun,
  [data-motion-toggle][aria-pressed='true'] .i-still {
    display: block;
  }
  [data-theme-toggle][aria-pressed='true'] .i-moon,
  [data-motion-toggle][aria-pressed='true'] .i-motion {
    display: none;
  }
  .hbtn[aria-pressed='true'] {
    color: var(--text);
    border-color: var(--line-3);
  }
  .menu-toggle {
    display: none;
    border-color: var(--line-3);
  }
  .menu-toggle i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2px;
    background: var(--text);
    transition: transform var(--t) var(--ease), top var(--t) var(--ease);
  }
  .menu-toggle i:first-of-type {
    top: 18px;
  }
  .menu-toggle i:last-of-type {
    top: 27px;
  }
  .menu-toggle[aria-expanded='true'] i:first-of-type {
    top: 22.5px;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] i:last-of-type {
    top: 22.5px;
    transform: rotate(-45deg);
  }
  .menu {
    display: none;
  }
  @media (max-width: 1180px) {
    .hbtn-text,
    .hbtn kbd {
      display: none;
    }
    .hbtn-find {
      padding-inline: 12px;
    }
  }
  @media (max-width: 1020px) {
    .site-header-inner {
      width: 100%;
      min-width: 0;
      gap: 8px;
    }
    .nav {
      display: none;
    }
    .header-end {
      margin-left: auto;
    }
    .header-end > [data-theme-toggle],
    .header-end > [data-motion-toggle] {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .menu {
      pointer-events: auto;
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      padding: 104px var(--gutter) 28px;
      overflow-y: auto;
      background: var(--ink-0);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition: clip-path 700ms var(--ease), visibility 0s linear 700ms;
    }
    .menu[data-open='true'] {
      clip-path: inset(0);
      visibility: visible;
      transition: clip-path 800ms var(--ease), visibility 0s;
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
    }
    .menu a {
      display: flex;
      align-items: baseline;
      gap: 14px;
      min-height: var(--tap);
      padding: 12px 0;
      border-bottom: 1px solid var(--line-2);
      opacity: 0;
      translate: 0 20px;
      transition: opacity 500ms var(--ease), translate 700ms var(--ease);
    }
    .menu[data-open='true'] a {
      opacity: 1;
      translate: none;
      transition-delay: calc(100ms + var(--i) * 45ms);
    }
    .menu a .display {
      font-size: clamp(1.9rem, 9vw, 3.2rem);
    }
    .nav-n {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-3);
    }
    .menu a[aria-current] .display {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 6px;
    }
    .menu-prefs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .menu-prefs .btn {
      flex: 1 1 160px;
      border-color: var(--line-3);
    }
  }
  @media (max-width: 420px) {
    .brand-name span {
      display: none;
    }
  }
</style>
