---
// Home hero. The <h1> is the real name (SEO, screen readers, no-JS); the
// particle field draws over it only once it's ready, then the text hides.
interface Props {
  projectCount: number;
  rooms: number;
  badges: number;
}
const { projectCount, rooms, badges } = Astro.props;
const base = import.meta.env.BASE_URL;
const roles = ['Security engineering', 'CSO @ Velnqo', 'Founder of KUSH', 'Software engineering'];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-grid blueprint" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-top">
      <p class="eyebrow">Software engineering / Cybersecurity</p>
      <p class="hero-flap" data-flap={roles.join('|')}>{roles[0]}</p>
    </div>

    <div class="hero-stage" data-hero-stage>
      <h1 id="hero-name" class="hero-name display">
        <span>Oscar</span>
        <span class="foil">Senior</span>
      </h1>
      <div class="hero-field" data-signal-field aria-hidden="true"></div>
    </div>

    <div class="hero-bottom">
      <p class="hero-bio">
        I'm Oscar, also Nops: a final-year DISC student in cybersecurity and IT, founder and developer of
        <a href={`${base}projects/kush/`}>KUSH</a>, and Chief Security Officer at Velnqo. I build real
        systems (a threat-intelligence platform, Rust and Tauri desktop apps, Discord-native platforms with real auth, rate
        limiting and audit logging) and practise offensive and defensive security on TryHackMe.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}projects/kush/`}>
          KUSH case study
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn btn-outline" href={`${base}projects/`}>All {projectCount} projects</a>
        <a class="btn btn-outline" href={`${base}#experience`}>Experience</a>
      </div>
      <dl class="hero-facts">
        <div><dt>Projects</dt><dd class="mono">{projectCount}</dd></div>
        <div><dt>TryHackMe rooms</dt><dd class="mono">{rooms}</dd></div>
        <div><dt>Badges</dt><dd class="mono">{badges}</dd></div>
      </dl>
    </div>
  </div>
  <a class="hero-scroll meta" href="#featured">Scroll</a>
</section>

<script>
  type Field = { dispose: () => void };
  let field: Field | null = null;

  const lowPower = () => {
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    return (nav.hardwareConcurrency ?? 8) <= 2 || (nav.deviceMemory ?? 8) <= 2 || nav.connection?.saveData === true;
  };
  const webgl = () => {
    try {
      return Boolean(document.createElement('canvas').getContext('webgl2'));
    } catch {
      return false;
    }
  };

  document.addEventListener('astro:page-load', () => {
    const host = document.querySelector<HTMLElement>('[data-signal-field]');
    if (!host || !document.documentElement.classList.contains('motion-ok') || lowPower() || !webgl()) return;
    const narrow = window.innerWidth < 720;
    // Load three.js only when the hero is actually going to animate.
    void import('../scripts/signal-field').then(async ({ mountSignalField }) => {
      field = await mountSignalField(host, narrow ? ['OSCAR', 'SENIOR'] : ['OSCAR SENIOR']);
      if (field) host.closest('[data-hero-stage]')?.setAttribute('data-live', 'true');
    });
  });
  document.addEventListener('astro:before-swap', () => {
    field?.dispose();
    field = null;
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + 24px);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 25%, #000 70%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 25%, #000 70%, transparent);
  }
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .hero-top .eyebrow {
    margin: 0;
  }
  .hero-flap {
    margin: 0;
    font-size: 13px;
    color: var(--text);
  }
  .hero-stage {
    position: relative;
    flex: 1;
    min-height: clamp(220px, 38vh, 440px);
    display: grid;
    align-items: center;
  }
  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.22em;
    margin: 0;
    font-size: clamp(3.6rem, 11.5vw, 11.5rem);
    line-height: 0.86;
    transition: opacity 700ms var(--ease);
  }
  .hero-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-field :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Once the particles are live the real text steps back (still in the DOM). */
  .hero-stage[data-live='true'] .hero-name {
    opacity: 0;
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-areas:
      'bio facts'
      'actions facts';
    gap: 22px 48px;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
  }
  .hero-bio {
    grid-area: bio;
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1.02rem, 1.3vw, 1.16rem);
    line-height: 1.65;
    color: var(--text-2);
  }
  .hero-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-self: end;
    margin: 0;
  }
  .hero-facts div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 0 0 18px;
    border-left: 1px solid var(--line);
  }
  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hero-facts dd {
    margin: 6px 0 0;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: var(--text);
  }
  .hero-scroll {
    position: absolute;
    right: var(--gutter);
    bottom: 22px;
    writing-mode: vertical-rl;
    color: var(--text-3);
  }
  @media (max-width: 860px) {
    .hero-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
      grid-template-areas: 'bio' 'actions' 'facts';
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
