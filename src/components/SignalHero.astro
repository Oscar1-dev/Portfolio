---
// Home hero, kept deliberately quiet: the name, one line, two actions and a
// slim glass status bar. The name is real text; each letter catches a foil
// highlight as the cursor passes (hero script), and on scroll the hero
// pins while the name tracks out and the rest lifts away.
interface Props {
  projectCount: number;
  rooms: number;
  badges: number;
}
const { projectCount, rooms } = Astro.props;
const base = import.meta.env.BASE_URL;
const lines = ['Oscar', 'Senior'];
---

<section class="hero" aria-labelledby="hero-name" data-progress="pin" data-scene="hero" data-hero>
  <div class="hero-frame">
    <div class="wrap hero-inner">
      <p class="hero-kicker mono">Software engineering <span aria-hidden="true">/</span> Cybersecurity</p>

      <h1 id="hero-name" class="hero-name display" aria-label="Oscar Senior">
        {
          lines.map((line, li) => (
            <span class="hero-line" aria-hidden="true">
              {[...line].map((ch, ci) => (
                <span class="ch" data-ch={ch} style={`--ci:${li * 6 + ci}`}>
                  {ch}
                </span>
              ))}
            </span>
          ))
        }
      </h1>

      <div class="hero-foot">
        <p class="hero-lede">
          Final-year DISC student in cybersecurity and IT. Founder and developer of <a href={`${base}projects/kush/`}>KUSH</a>, Chief Security
          Officer at Velnqo.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${base}projects/kush/`}>
            KUSH case study
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-glass" href={`${base}projects/`}>All {projectCount} projects</a>
        </div>
      </div>

      <ul class="hero-status glass" aria-label="At a glance">
        <li><span class="dot" aria-hidden="true"></span><b>CSO</b> Velnqo</li>
        <li><b>Founder</b> KUSH</li>
        <li><b>Student</b> DISC</li>
        <li><b>{rooms}</b> TryHackMe rooms</li>
      </ul>
    </div>
  </div>
</section>

<script>
  // Letters warm up near the cursor: a foil copy of each letter fades in by
  // distance. Rects are read once per frame, only while the pointer moves.
  let off: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    off?.();
    off = null;
    const name = document.querySelector<HTMLElement>('.hero-name');
    if (!name || !matchMedia('(hover: hover)').matches || !document.documentElement.classList.contains('motion-ok')) return;
    const letters = [...name.querySelectorAll<HTMLElement>('.ch')];
    let raf = 0;
    let px = -1e4;
    let py = -1e4;
    const update = () => {
      raf = 0;
      for (const el of letters) {
        const r = el.getBoundingClientRect();
        const d = Math.hypot(px - (r.left + r.width / 2), py - (r.top + r.height / 2));
        const heat = Math.max(0, 1 - d / Math.max(220, r.height * 1.6));
        el.style.setProperty('--heat', (heat * heat).toFixed(3));
      }
    };
    const onMove = (e: PointerEvent) => {
      px = e.clientX;
      py = e.clientY;
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    off = () => {
      window.removeEventListener('pointermove', onMove);
      cancelAnimationFrame(raf);
    };
  });
  document.addEventListener('astro:before-swap', () => {
    off?.();
    off = null;
  });
</script>

<style>
  .hero {
    position: relative;
    --p: 0;
    overflow-x: clip;
  }
  :global(.motion-ok) .hero {
    height: 165vh;
  }
  .hero-frame {
    position: relative;
    height: 100svh;
    min-height: 620px;
    display: flex;
    flex-direction: column;
  }
  :global(.motion-ok) .hero-frame {
    position: sticky;
    top: 0;
  }
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: clamp(28px, 5vh, 56px);
  }
  .hero-kicker {
    margin: 0 0 clamp(14px, 2.4vh, 26px);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.66);
    opacity: calc(1 - var(--p) * 3);
  }
  .hero-kicker span {
    color: rgb(var(--scene-b));
    margin: 0 0.5em;
  }

  /* The name: as large as the viewport allows, two lines. */
  .hero-name {
    margin: 0;
    font-size: clamp(4.2rem, 16.2vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: #fff;
  }
  .hero-line {
    display: block;
    white-space: nowrap;
    letter-spacing: calc(-0.045em + var(--p) * 0.14em);
  }
  .hero-line + .hero-line {
    padding-left: 0.42em;
  }
  .ch {
    --heat: 0;
    position: relative;
    display: inline-block;
    translate: 0 calc(var(--heat) * -0.05em);
    transition: translate 0.5s var(--ease);
  }
  .ch::after {
    content: attr(data-ch);
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, rgb(var(--scene-c)), rgb(var(--scene-b)) 45%, rgb(var(--scene-a)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: var(--heat);
    transition: opacity 0.35s linear;
    pointer-events: none;
  }
  /* First paint: letters rise in, staggered. */
  :global(.motion-ok) .ch {
    animation: rise 1.3s var(--ease) both;
    animation-delay: calc(120ms + var(--ci) * 45ms);
  }
  @keyframes rise {
    from {
      translate: 0 0.5em;
      opacity: 0;
      filter: blur(10px);
    }
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px 40px;
    margin-top: clamp(26px, 5vh, 54px);
    translate: 0 calc(var(--p) * -70px);
    opacity: calc(1 - var(--p) * 2.2);
  }
  .hero-lede {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.82);
  }
  .hero-lede a {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(var(--scene-b));
    text-underline-offset: 4px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    width: fit-content;
    margin: clamp(22px, 4vh, 40px) 0 0;
    padding: 10px 8px;
    list-style: none;
    border-radius: 999px;
    --glass-bg: rgb(14 13 20 / 0.42);
    translate: 0 calc(var(--p) * -110px);
    opacity: calc(1 - var(--p) * 2);
  }
  .hero-status li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 16px;
    font-size: 13.5px;
    color: rgb(255 255 255 / 0.72);
  }
  .hero-status li + li {
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }
  .hero-status b {
    font-weight: 600;
    color: #fff;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--scene-b));
    box-shadow: 0 0 0 3px rgb(var(--scene-b) / 0.25);
    animation: pulse 2.4s var(--ease-in-out) infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(var(--scene-b) / 0.04);
    }
  }

  @media (max-width: 860px) {
    :global(.motion-ok) .hero {
      height: auto;
    }
    :global(.motion-ok) .hero-frame {
      position: relative;
    }
    .hero-frame {
      min-height: 100svh;
      height: auto;
    }
    .hero-line + .hero-line {
      padding-left: 0;
    }
    .hero-status {
      border-radius: 20px;
    }
    .hero-status li + li {
      border-left: 0;
    }
  }
</style>
